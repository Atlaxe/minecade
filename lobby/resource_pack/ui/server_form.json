{
  "namespace": "server_form",

  // Minecade's themed menus. Forms whose title starts with a layout mark (formatting codes that
  // never render, see lobby/behavior_pack/scripts/menus.ts) get a layout from minecade_forms.json;
  // every other form stays vanilla. Merged into the vanilla file, so updates to it still apply.
  //
  // Vanilla sizes this panel [0, 0] (its forms are fixed sizes centered on it), which makes every
  // percentage size inside it zero. Filling the screen lets our layouts size against the screen
  // (the game grid is 80% of its height); vanilla's forms stay the same, centered.
  "main_screen_content": {
    "size": ["100%", "100%"],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "minecade_forms_factory_panel": {
            "type": "panel",
            "size": ["100%", "100%"],
            "factory": {
              "name": "server_form_factory",
              "control_ids": {
                "long_form": "@minecade_forms.long_form"
              }
            }
          }
        }
      }
    ]
  },

  // The vanilla action form hides itself for marked titles. Like every control a binding shows, it
  // starts hidden, so a new form's first frame (before the bindings) has nothing stale to click.
  "long_form": {
    "visible": false,
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§m§a§i§n' - '§g§r§i§d' - '§g§a§m§e' - '§s§l§s§t' - '§s§d§t§l') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  }
}

{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecade:white_paintball_pistol",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/minecade/guns/pistol/white",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.minecade.gun_pistol"
      },
      "animations": {
        "first_person_hip": "animation.minecade.gun_pistol.first_person_hip",
        "first_person_aim": "animation.minecade.gun_pistol.first_person_aim",
        "third_person": "animation.minecade.gun_pistol.third_person",
        "recoil": "animation.minecade.gun_pistol.recoil"
      },
      "scripts": {
        "initialize": [
          "v.aim = 0;",
          "v.kick = 0;"
        ],
        "pre_animation": [
          "v.aim = math.lerp(v.aim, q.cooldown_time_remaining('minecade_aim') > 0, math.min(q.delta_time * 12, 1));",
          "v.kick_t = 1 - math.clamp(q.cooldown_time_remaining('slot.weapon.mainhand') / 0.3, 0, 1);",
          "v.kick = (v.kick_t < 0.13 ? v.kick_t / 0.13 : math.pow((1 - v.kick_t) / 0.87, 2)) * (1 - v.aim * 0.4);"
        ],
        "animate": [
          {
            "first_person_hip": "c.is_first_person * (1 - v.aim)"
          },
          {
            "first_person_aim": "c.is_first_person * v.aim"
          },
          {
            "third_person": "!c.is_first_person"
          },
          "recoil"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}

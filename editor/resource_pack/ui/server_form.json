{
  "namespace": "server_form",

  // The map editor's menus. Forms whose title starts with a layout mark (formatting codes that never
  // render, see editor/behavior_pack/scripts/marks.ts) get a layout in editor_forms.json; every
  // other form stays vanilla. Merged into the vanilla file, so updates to it still apply.
  //
  // Vanilla sizes this panel [0, 0] (its forms are fixed sizes centered on it), which makes every
  // percentage size inside it zero. Filling the screen lets the side menu take the screen's full
  // height; vanilla's forms stay the same, centered.
  "main_screen_content": {
    "size": ["100%", "100%"],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "editor_forms_factory_panel": {
            "type": "panel",
            "size": ["100%", "100%"],
            "factory": {
              "name": "server_form_factory",
              "control_ids": {
                "long_form": "@editor_forms.long_form"
              }
            }
          }
        }
      }
    ]
  },

  // The vanilla action form hides itself for marked titles (the side mark or the map menu's). Like every control a binding shows, it
  // starts hidden, so a new form's first frame (before the bindings) has nothing stale to click.
  "long_form": {
    "visible": false,
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "(((#title_text - '§s§i§d§e') = #title_text) and ((#title_text - '§m§a§p') = #title_text))",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  }
}

{
  "name": "minecade-network",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "spike:build": "tsx spike/build-packs.ts",
    "spike:world": "tsx spike/make-world.ts",
    "spike:up": "docker compose -f spike/docker-compose.spike.yml --env-file .env up -d --build",
    "spike:down": "docker compose -f spike/docker-compose.spike.yml --env-file .env down",
    "cmd": "tsx tools/build/send-command.ts",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.packs.json"
  },
  "devDependencies": {
    "@minecraft/common": "1.3.0",
    "@minecraft/server": "2.11.0",
    "@minecraft/server-admin": "1.0.0-beta.1.26.60-stable",
    "@minecraft/server-net": "1.0.0-beta.1.26.60-stable",
    "@minecraft/server-ui": "2.3.0",
    "@minecraft/vanilla-data": "1.26.60",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.6",
    "dockerode": "^5.0.1",
    "esbuild": "^0.28.2",
    "prismarine-nbt": "^2.8.0",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

{
  "namespace": "hud",

  // Block Party's HUD (the plan's "Turns and controls"). Only Block Party's servers load this pack.
  //
  // The hotbar is the pack's own (the user's call after two tries at restyling vanilla's, whose
  // empty slots couldn't be hidden): the game hides vanilla's (setHudVisibility, Hotbar) and puts
  // codes on the action bar for each slot in use, its icon and the selected one, and
  // ui/blockparty_hud.json (generated by tools/assets/blockparty-hud-ui.ts) draws it bottom right,
  // with the selected item's name and what it does over it. Vanilla's slots still pick: scrolling
  // and number keys. The loading screen (the star field and Minecade's logo, faded in and out a level
  // at a time) rides the same way. Both sit in the core pack's full-screen action bar panel, like the
  // gun scope (packages/minigame-core's hud_screen.json), the loading screen on top.

  // Vanilla's popup of the selected item's name (the core pack's one-line version of it): the bar
  // shows the name.
  "item_name_text_root": { "ignored": true },

  "hud_actionbar_text": {
    "modifications": [
      { "array_name": "controls", "operation": "insert_back", "value": [ { "bp_hotbar@blockparty_hud.hotbar": {} }, { "bp_loading@blockparty_hud.loading": {} } ] }
    ]
  }
}

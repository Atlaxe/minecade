{
  "namespace": "hud",

  // The match clock. Bedrock has no script API for HUD text, so games send the clock on the
  // action bar, starting with a mark made of formatting codes that never render
  // (HUD_MARK in packages/minigame-core/src/hud.ts): "<mark>§f2:53§7   Lives: 2". The action bar
  // becomes a full-screen panel: marked lines show in a box top right with a clock icon, and
  // anything else shows exactly like the vanilla action bar.
  //
  // A game that shows each player their own score (One in the Quiver's kills) puts the number at
  // the end of the line as more formatting codes (countCodes in hud.ts: "§k§t§1§k§u§5§r" is 15),
  // and a second box left of the clock's shows a skull and the digits those codes name.
  //
  // A game played in best-of rounds puts them in more codes (bestOfCodes in hud.ts), shown in a box
  // left of the others: ui/minecade_rounds.json, generated by tools/assets/rounds-hud.ts. Without a
  // clock, the clock's box drops its icon ('§k§o') or goes altogether ('§k§v').
  //
  // What JSON UI allows here, tested in-game on 26.60 (see docs/ui.md):
  //   - engine variables such as $actionbar_text work in expressions only after being copied
  //     into the control's own variable ("$atext": "$actionbar_text");
  //   - string subtraction works in "visible" checks, but doesn't produce text;
  //   - view bindings need a #property, so they can't read $atext alone.
  "hud_actionbar_text": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "offset": [ 0, 0 ],
    "controls": [
      { "mc_actionbar_plain@hud.mc_actionbar_plain": {} },
      { "mc_hud_row@hud.mc_hud_row": {} }
    ]
  },

  // No mark: the vanilla action bar.
  "mc_actionbar_plain": {
    "type": "image",
    "$atext": "$actionbar_text",
    "size": [ "100%c + 12px", "100%c + 5px" ],
    "offset": [ 0, "50%-68px" ],
    "texture": "textures/ui/hud_tip_text_background",
    "alpha": "@hud.anim_actionbar_text_background_alpha_out",
    "visible": "(($atext - '§r§m§c§r') = $atext)",
    "controls": [
      {
        "actionbar_message": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "color": "$tool_tip_text",
          "enable_profanity_filter": true,
          "layer": 31,
          "text": "$actionbar_text",
          "shadow": true,
          "localize": false,
          "alpha": "@hud.anim_actionbar_text_alpha_out"
        }
      }
    ]
  },

  // Marked: top right, the rounds' box and the own score's box (when the line has them) and the
  // clock's, side by side.
  "mc_hud_row": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "$atext": "$actionbar_text",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -4, 4 ],
    "size": [ "100%c", 14 ],
    "visible": "(not (($atext - '§r§m§c§r') = $atext))",
    "controls": [
      { "mc_rounds_box@minecade_rounds.box": {} },
      { "mc_rounds_gap@minecade_rounds.gap": {} },
      { "mc_count_box@hud.mc_count_box": {} },
      {
        "mc_count_gap": {
          "type": "panel",
          "$atext": "$actionbar_text",
          "size": [ 2, 14 ],
          "ignored": "(($atext - '§k§u') = $atext)"
        }
      },
      { "mc_hud_box@hud.mc_hud_box": {} }
    ]
  },

  // The own score: a skull, then the digits. Each place (hundreds, tens, units) has a label per
  // digit, and only the one whose codes are in the line is kept ("ignored" leaves the others out
  // of the row, so a 5 is as narrow as one digit). A line without a score has no units codes, and
  // no box.
  "mc_count_box": {
    "type": "image",
    "$atext": "$actionbar_text",
    "texture": "textures/ui/hud_tip_text_background",
    "size": [ "100%c + 8px", 14 ],
    "layer": 30,
    "alpha": "@hud.anim_actionbar_text_background_alpha_out",
    "ignored": "(($atext - '§k§u') = $atext)",
    "visible": "(not (($atext - '§k§u') = $atext))",
    "controls": [
      {
        "mc_count_row": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ "100%c", 10 ],
          "controls": [
            {
              "mc_skull_icon": {
                "type": "image",
                "texture": "textures/minecade/hud/skull",
                "size": [ 10, 10 ],
                "layer": 31,
                "alpha": "@hud.anim_actionbar_text_alpha_out"
              }
            },
            { "mc_skull_gap": { "type": "panel", "size": [ 3, 10 ] } },
            { "h1@hud.mc_digit": { "text": "1", "ignored": "(($atext - '§k§h§1') = $atext)", "visible": "(not (($atext - '§k§h§1') = $atext))" } },
            { "h2@hud.mc_digit": { "text": "2", "ignored": "(($atext - '§k§h§2') = $atext)", "visible": "(not (($atext - '§k§h§2') = $atext))" } },
            { "h3@hud.mc_digit": { "text": "3", "ignored": "(($atext - '§k§h§3') = $atext)", "visible": "(not (($atext - '§k§h§3') = $atext))" } },
            { "h4@hud.mc_digit": { "text": "4", "ignored": "(($atext - '§k§h§4') = $atext)", "visible": "(not (($atext - '§k§h§4') = $atext))" } },
            { "h5@hud.mc_digit": { "text": "5", "ignored": "(($atext - '§k§h§5') = $atext)", "visible": "(not (($atext - '§k§h§5') = $atext))" } },
            { "h6@hud.mc_digit": { "text": "6", "ignored": "(($atext - '§k§h§6') = $atext)", "visible": "(not (($atext - '§k§h§6') = $atext))" } },
            { "h7@hud.mc_digit": { "text": "7", "ignored": "(($atext - '§k§h§7') = $atext)", "visible": "(not (($atext - '§k§h§7') = $atext))" } },
            { "h8@hud.mc_digit": { "text": "8", "ignored": "(($atext - '§k§h§8') = $atext)", "visible": "(not (($atext - '§k§h§8') = $atext))" } },
            { "h9@hud.mc_digit": { "text": "9", "ignored": "(($atext - '§k§h§9') = $atext)", "visible": "(not (($atext - '§k§h§9') = $atext))" } },
            { "t0@hud.mc_digit": { "text": "0", "ignored": "(($atext - '§k§t§0') = $atext)", "visible": "(not (($atext - '§k§t§0') = $atext))" } },
            { "t1@hud.mc_digit": { "text": "1", "ignored": "(($atext - '§k§t§1') = $atext)", "visible": "(not (($atext - '§k§t§1') = $atext))" } },
            { "t2@hud.mc_digit": { "text": "2", "ignored": "(($atext - '§k§t§2') = $atext)", "visible": "(not (($atext - '§k§t§2') = $atext))" } },
            { "t3@hud.mc_digit": { "text": "3", "ignored": "(($atext - '§k§t§3') = $atext)", "visible": "(not (($atext - '§k§t§3') = $atext))" } },
            { "t4@hud.mc_digit": { "text": "4", "ignored": "(($atext - '§k§t§4') = $atext)", "visible": "(not (($atext - '§k§t§4') = $atext))" } },
            { "t5@hud.mc_digit": { "text": "5", "ignored": "(($atext - '§k§t§5') = $atext)", "visible": "(not (($atext - '§k§t§5') = $atext))" } },
            { "t6@hud.mc_digit": { "text": "6", "ignored": "(($atext - '§k§t§6') = $atext)", "visible": "(not (($atext - '§k§t§6') = $atext))" } },
            { "t7@hud.mc_digit": { "text": "7", "ignored": "(($atext - '§k§t§7') = $atext)", "visible": "(not (($atext - '§k§t§7') = $atext))" } },
            { "t8@hud.mc_digit": { "text": "8", "ignored": "(($atext - '§k§t§8') = $atext)", "visible": "(not (($atext - '§k§t§8') = $atext))" } },
            { "t9@hud.mc_digit": { "text": "9", "ignored": "(($atext - '§k§t§9') = $atext)", "visible": "(not (($atext - '§k§t§9') = $atext))" } },
            { "u0@hud.mc_digit": { "text": "0", "ignored": "(($atext - '§k§u§0') = $atext)", "visible": "(not (($atext - '§k§u§0') = $atext))" } },
            { "u1@hud.mc_digit": { "text": "1", "ignored": "(($atext - '§k§u§1') = $atext)", "visible": "(not (($atext - '§k§u§1') = $atext))" } },
            { "u2@hud.mc_digit": { "text": "2", "ignored": "(($atext - '§k§u§2') = $atext)", "visible": "(not (($atext - '§k§u§2') = $atext))" } },
            { "u3@hud.mc_digit": { "text": "3", "ignored": "(($atext - '§k§u§3') = $atext)", "visible": "(not (($atext - '§k§u§3') = $atext))" } },
            { "u4@hud.mc_digit": { "text": "4", "ignored": "(($atext - '§k§u§4') = $atext)", "visible": "(not (($atext - '§k§u§4') = $atext))" } },
            { "u5@hud.mc_digit": { "text": "5", "ignored": "(($atext - '§k§u§5') = $atext)", "visible": "(not (($atext - '§k§u§5') = $atext))" } },
            { "u6@hud.mc_digit": { "text": "6", "ignored": "(($atext - '§k§u§6') = $atext)", "visible": "(not (($atext - '§k§u§6') = $atext))" } },
            { "u7@hud.mc_digit": { "text": "7", "ignored": "(($atext - '§k§u§7') = $atext)", "visible": "(not (($atext - '§k§u§7') = $atext))" } },
            { "u8@hud.mc_digit": { "text": "8", "ignored": "(($atext - '§k§u§8') = $atext)", "visible": "(not (($atext - '§k§u§8') = $atext))" } },
            { "u9@hud.mc_digit": { "text": "9", "ignored": "(($atext - '§k§u§9') = $atext)", "visible": "(not (($atext - '§k§u§9') = $atext))" } }
          ]
        }
      }
    ]
  },

  "mc_digit": {
    "type": "label",
    "$atext": "$actionbar_text",
    "size": [ "default", 10 ],
    "color": [ 1.0, 1.0, 1.0 ],
    "layer": 31,
    "shadow": true,
    "localize": false,
    "alpha": "@hud.anim_actionbar_text_alpha_out"
  },

  // The clock (and anything after it), after a clock icon. The mark and the score's codes are
  // formatting codes, so the label shows the line as is. A best-of game with no clock leaves out
  // the icon ('§k§o', the rest of the line still shows) or the whole box ('§k§v', nothing to show).
  "mc_hud_box": {
    "type": "image",
    "$atext": "$actionbar_text",
    "texture": "textures/ui/hud_tip_text_background",
    "size": [ "100%c + 8px", "100%c + 4px" ],
    "layer": 30,
    "alpha": "@hud.anim_actionbar_text_background_alpha_out",
    "ignored": "(not (($atext - '§k§v') = $atext))",
    "controls": [
      {
        "mc_clock_row": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ "100%c", 10 ],
          "controls": [
            {
              "mc_clock_icon": {
                "type": "image",
                "$atext": "$actionbar_text",
                "texture": "textures/minecade/hud/clock",
                "size": [ 10, 10 ],
                "layer": 31,
                "alpha": "@hud.anim_actionbar_text_alpha_out",
                "ignored": "(not (($atext - '§k§o') = $atext))"
              }
            },
            { "mc_clock_gap": { "type": "panel", "$atext": "$actionbar_text", "size": [ 3, 10 ], "ignored": "(not (($atext - '§k§o') = $atext))" } },
            {
              "mc_hud_text": {
                "type": "label",
                "size": [ "default", 10 ],
                "color": [ 1.0, 1.0, 1.0 ],
                "layer": 31,
                "text": "$actionbar_text",
                "shadow": true,
                "localize": false,
                "alpha": "@hud.anim_actionbar_text_alpha_out"
              }
            }
          ]
        }
      }
    ]
  },

  // The item name above the hotbar shows only its first line: the name. Vanilla adds a locked
  // item's lock lines under it ("Can't Move Items can't be: ...", "This item is not lost on death").
  // texts/en_US.lang draws them as nothing, and this cuts off whatever lines are left, so the box
  // stays one line tall. Vanilla's item_name_text_root, with the label in a one-line panel that
  // clips; the background follows that panel.
  "item_name_text_root": {
    "type": "panel",
    "size": [ "100%cm", "100%cm" ],
    "$show_interact_padding|default": false,
    "$show_survival_padding|default": false,
    "$show_text_background|default": false,
    "$localize|default": true,
    "$text_color|default": "$tool_tip_text",
    "$text_binding|default": "#item_text",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "$wait_duration|default": 1,
    "$destroy_id|default": "item_name_text",
    "controls": [
      {
        "item_text_aligner": {
          "type": "stack_panel",
          "size": [ "100%cm", "100%c" ],
          "controls": [
            {
              "item_text_control": {
                "type": "panel",
                "size": [ "100%cm", "100%cm" ],
                "controls": [
                  {
                    "item_text_background": {
                      "ignored": "(not $show_text_background)",
                      "type": "image",
                      "size": [ "100%sm + 12px", "100%sm + 5px" ],
                      "texture": "textures/ui/hud_tip_text_background",
                      "alpha": "@hud.anim_item_name_background_alpha_in"
                    }
                  },
                  {
                    "item_text_first_line": {
                      "type": "panel",
                      "size": [ "100%c", 10 ],
                      "clips_children": true,
                      "controls": [
                        {
                          "item_text_label": {
                            "type": "label",
                            "anchor_from": "top_middle",
                            "anchor_to": "top_middle",
                            "max_size": [ 200, "default" ],
                            "text_alignment": "center",
                            "layer": 31,
                            "color": "$text_color",
                            "text": "#text",
                            "localize": "$localize",
                            "alpha": "@hud.anim_item_name_text_alpha_in",
                            "shadow": true,
                            "bindings": [ { "binding_name": "$text_binding", "binding_name_override": "#text" } ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "interact_padding@common.empty_panel": {
                "visible": "$show_interact_padding",
                "size": [ "100%sm", 18 ],
                "bindings": [ { "binding_name": "#interact_visible", "binding_name_override": "#visible", "binding_condition": "always" } ]
              }
            },
            {
              "survival_buffer@common.empty_panel": {
                "visible": "$show_survival_padding",
                "size": [ "100%sm", 17 ],
                "bindings": [ { "binding_name": "#show_survival_ui", "binding_name_override": "#visible" } ]
              }
            }
          ]
        }
      }
    ]
  }
}

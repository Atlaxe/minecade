{
  "format_version": "1.21.100",
  "minecraft:entity": {
    "description": {
      "identifier": "minecade:fake_player",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "minecade:skin": {"type": "int", "range": [0, 3], "default": 0, "client_sync": true},
        "minecade:pose": {"type": "int", "range": [0, 15], "default": 0, "client_sync": true},
        "minecade:tint": {"type": "int", "range": [0, 16777216], "default": 0, "client_sync": true}
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["fake_player"] },
      "minecraft:collision_box": { "width": 0.6, "height": 1.8 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:knockback_resistance": { "value": 0 },
      "minecraft:movement": { "value": 0.1 },
      "minecraft:movement.basic": {},
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": false },
      "minecraft:breathable": { "breathes_air": true, "breathes_water": true },
      "minecraft:persistent": {},
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "Kill",
            "swing": true,
            "on_interact": { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "event": "minecade:poked", "target": "self" }
          }
        ]
      }
    },
    "component_groups": {
      "minecade:walking": {
        "minecraft:physics": {},
        "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true }
      },
      "minecade:floating": {
        "minecraft:physics": { "has_gravity": false, "has_collision": false },
        "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false }
      }
    },
    "events": {
      "minecraft:entity_spawned": { "add": { "component_groups": ["minecade:walking"] } },
      "minecade:walk": { "remove": { "component_groups": ["minecade:floating"] }, "add": { "component_groups": ["minecade:walking"] } },
      "minecade:float": { "remove": { "component_groups": ["minecade:walking"] }, "add": { "component_groups": ["minecade:floating"] } },
      "minecade:poked": {}
    }
  }
}

{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecade:smg",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/minecade/guns/arsenal/smg",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.minecade.gun_smg"
      },
      "animations": {
        "first_person_hip": "animation.minecade.gun_smg.first_person_hip",
        "third_person": "animation.minecade.gun_smg.third_person",
        "recoil": "animation.minecade.gun_smg.recoil"
      },
      "scripts": {
        "initialize": [
          "v.kick = 0;"
        ],
        "pre_animation": [
          "v.kick_t = 1 - math.clamp(q.cooldown_time_remaining('slot.weapon.mainhand') / 0.1, 0, 1);",
          "v.kick = (v.kick_t < 0.3 ? v.kick_t / 0.3 : math.pow((1 - v.kick_t) / 0.7, 2));"
        ],
        "animate": [
          {
            "first_person_hip": "c.is_first_person"
          },
          {
            "third_person": "!c.is_first_person"
          },
          "recoil"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}

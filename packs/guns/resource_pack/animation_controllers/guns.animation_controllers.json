{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minecade.gun_sniper_rifle.hold": {
      "initial_state": "hip",
      "states": {
        "hip": {
          "animations": [
            {
              "first_person_hip": "c.is_first_person"
            },
            {
              "first_person_hip_own": "c.is_first_person"
            },
            {
              "third_person": "!c.is_first_person"
            },
            {
              "third_person_own": "!c.is_first_person"
            }
          ],
          "transitions": [
            {
              "aim": "(q.is_item_name_any('slot.weapon.offhand', 0, 'minecade:aim_marker') || c.owning_entity->q.is_item_name_any('slot.weapon.offhand', 0, 'minecade:aim_marker'))"
            }
          ],
          "blend_transition": 0.2
        },
        "aim": {
          "animations": [
            {
              "first_person_aim": "c.is_first_person"
            },
            {
              "first_person_aim_own": "c.is_first_person"
            },
            {
              "third_person": "!c.is_first_person"
            },
            {
              "third_person_own": "!c.is_first_person"
            }
          ],
          "transitions": [
            {
              "hip": "!(q.is_item_name_any('slot.weapon.offhand', 0, 'minecade:aim_marker') || c.owning_entity->q.is_item_name_any('slot.weapon.offhand', 0, 'minecade:aim_marker'))"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },

{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecade:rocket",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/minecade/guns/arsenal/rocket"
      },
      "geometry": {
        "default": "geometry.minecade.rocket"
      },
      "render_controllers": [
        "controller.render.minecade.rocket"
      ],
      "particle_effects": {
        "trail": "minecade:rocket_trail"
      },
      "animations": {
        "fly": "animation.minecade.rocket.fly",
        "trail": "controller.animation.minecade.rocket.trail"
      },
      "scripts": {
        "initialize": [
          "v.yaw = 0;",
          "v.pitch = 0;"
        ],
        "pre_animation": [
          "v.moving = math.abs(q.movement_direction(0)) + math.abs(q.movement_direction(1)) + math.abs(q.movement_direction(2)) > 0.5;",
          "v.yaw = v.moving ? math.atan2(-q.movement_direction(0), q.movement_direction(2)) : v.yaw;",
          "v.pitch = v.moving ? math.asin(math.clamp(-q.movement_direction(1), -1, 1)) : v.pitch;"
        ],
        "animate": [
          "fly",
          "trail"
        ]
      }
    }
  }
}

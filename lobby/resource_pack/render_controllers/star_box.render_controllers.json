{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.minecade.star_box": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "ignore_lighting": true,
      "part_visibility": [
        {
          "*": true
        },
        {
          "moving": false
        }
      ]
    },
    "controller.render.minecade.star_box_moving": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.moving"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "moving": true
        }
      ],
      "uv_anim": {
        "offset": [
          "-math.mod(query.life_time / 30.0, 1.0)",
          0.0
        ],
        "scale": [
          1.0,
          1.0
        ]
      },
      "ignore_lighting": true
    }
  }
}

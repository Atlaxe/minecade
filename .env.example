# Copy to .env and fill in. .env is gitignored.

# Required. TRUE means you accept the Minecraft EULA (https://www.minecraft.net/eula)
# and the Microsoft Privacy Policy. The Docker build refuses to download BDS without it.
EULA=

# Bedrock Dedicated Server version. Must match your players' client version.
BDS_VERSION=1.26.60.6

# Address remote friends use. "auto" looks up your public IP at container start
# (https://api.ipify.org). A DDNS hostname also works.
PUBLIC_HOST=auto

# Your PC's LAN IP. Players listed in LAN_PLAYERS are transferred here instead of PUBLIC_HOST.
LAN_HOST=192.168.40.98

# Comma-separated gamertags of players on your home network (at least your own).
LAN_PLAYERS=

# Comma-separated gamertags allowed to join. Empty means anyone with the address can join.
ALLOW_LIST=

# How packs talk to the orchestrator: http (server-net) or log (log lines + stdin).
TRANSPORT=http

# The skin watcher's gamertag: a spare Microsoft account (with an Xbox profile, never anyone's
# main one) that stays in the lobby to save players' skins for the stats screens and hologram.
# The lobby keeps it invisible and out of games. Empty turns the watcher off. Its first start asks
# for a sign-in: docker logs minecade-watcher. See docs/skins.md.
WATCHER_GAMERTAG=

# The map editor (npm run editor, or the Panel's Map editor page): its editor lobby on port 19132,
# Select on 19133 and Edit on 19134, so the network is stopped while it runs. LAN_PLAYERS can
# always join it; these comma-separated gamertags can too. Everyone else is refused.
EDITOR_ALLOW_LIST=

# Comma-separated gamertags who get the editor's tools (spawns, the checklist, undo). Everyone else
# who joins builds in creative. Empty means everyone in LAN_PLAYERS.
MAP_EDITORS=

# The lobby map (a folder in lobby/maps/). Empty means spaceship. The Panel has a picker for it;
# restart the network to apply.
LOBBY_MAP=

# Dev only: override every game's minimum player count (e.g. 1 for solo testing).
DEV_MIN_PLAYERS=

# Dev only: add this many made-up games to the lobby's menus, to test scrolling (e.g. 8).
# They can't be started.
DEV_DEMO_GAMES=

# Dev only: 1 adds a Preview button to the terminal's main menu. Pick a hologram screen and it
# stays on the hologram (with sample data) until the terminal is tapped again, so you can see it
# without a form in the way.
DEV_HOLO_PREVIEW=

# Dev only: 1 shows made-up stats (players, matches, ranks) in the lobby's stats screens, kept in
# memory only. The real stats database isn't read or changed while it's on.
DEV_DEMO_STATS=

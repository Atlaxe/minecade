{
  "namespace": "hud",

  // Block Party's hotbar (the plan's "Turns and controls"): vanilla's hotbar restyled, not hidden
  // and replaced, so scrolling, number keys, a controller's bumpers and tapping a slot on a touch
  // screen all still pick a slot. Each slot gets the game's tile (textures/blockparty/hud/slot,
  // drawn by tools/assets/blockparty-hud.py) in place of vanilla's gray slot art, the selected slot a
  // gold frame, and the selected item's name and what it does (its lore) show over the bar and stay.
  // Only Block Party's servers load this pack. The core pack changes item_name_text_root (one line
  // for the vanilla popup), never these controls; each change below is a modification of vanilla's
  // own definition rather than a copy of it.
  //
  // Only the slots in use show: an empty slot draws no tile, and no gold frame when it's selected
  // (an item's #item_id_aux is 0 when the slot is empty). The game puts its items in the middle
  // slots, so what shows is centered, and moves a selection that lands on an empty slot on to the
  // next one in use (spike.ts, keepHotbars).

  // Vanilla's gray slots: the desktop bar draws them in one piece behind the grid, the touch bar
  // one a slot; and the caps at the bar's ends.
  "hotbar_slots_renderer": { "ignored": true },
  "hotbar_renderer": { "ignored": true },
  "hotbar_start_cap": { "ignored": true },
  "hotbar_end_cap": { "ignored": true },

  "hotbar_slot_selected_image": {
    "texture": "textures/blockparty/hud/selected",
    "size": [ 24, 24 ],
    "visible": false,
    "bindings": [
      { "binding_name": "#slot_selected", "binding_type": "collection", "binding_collection_name": "$hotbar_collection_name" },
      { "binding_name": "#item_id_aux", "binding_type": "collection", "binding_collection_name": "$hotbar_collection_name" },
      { "binding_type": "view", "source_property_name": "(#slot_selected and (not (#item_id_aux = 0)))", "target_property_name": "#visible" }
    ]
  },

  "gui_hotbar_grid_item": {
    "modifications": [
      { "array_name": "controls", "operation": "insert_front", "value": [ { "bp_slot@hud.bp_slot": {} } ] }
    ]
  },
  "gui_hotbar_grid_item_pocket": {
    "modifications": [
      { "array_name": "controls", "operation": "insert_front", "value": [ { "bp_slot@hud.bp_slot": { "size": [ "100%", "100%" ] } } ] }
    ]
  },

  // The name and what it does, over the bar: a zero-size anchor keeps the label from widening the
  // grid, so the slots never move.
  "hotbar_grid_frame": {
    "modifications": [
      { "array_name": "controls", "operation": "insert_back", "value": [ { "bp_item_text_anchor@hud.bp_item_text_anchor": {} } ] }
    ]
  },

  "bp_slot": {
    "type": "image",
    "texture": "textures/blockparty/hud/slot",
    "size": [ 20, 22 ],
    "layer": 1,
    "visible": false,
    "bindings": [
      { "binding_name": "#item_id_aux", "binding_type": "collection", "binding_collection_name": "$hotbar_collection_name" },
      { "binding_type": "view", "source_property_name": "(not (#item_id_aux = 0))", "target_property_name": "#visible" }
    ]
  },

  // Minecade's logo on the black while an arena loads (spike.ts, behindBlack): the game shows a
  // title that is only LOADING_MARK ('§r§m§l§r', formatting codes that never render), and the logo
  // rides at the front of vanilla's title, so it fades in and out with it. The title's own text is
  // the mark (nothing shows) and its dark box is lost on the black. Any other title hides the logo.
  // The logo is the core pack's (textures/minecade/ui/logo, every server has it).
  "hud_title_text": {
    "modifications": [
      { "array_name": "controls", "operation": "insert_front", "value": [ { "bp_loading_logo@hud.bp_loading_logo": {} } ] }
    ]
  },

  "bp_loading_logo": {
    "type": "panel",
    "size": [ "100%", 0 ],
    "visible": false,
    "bindings": [
      { "binding_name": "#hud_title_text_string", "binding_type": "global" },
      { "binding_type": "view", "source_property_name": "(not ((#hud_title_text_string - '§r§m§l§r') = #hud_title_text_string))", "target_property_name": "#visible" }
    ],
    "controls": [
      {
        "bp_loading_logo_image": {
          "type": "image",
          "texture": "textures/minecade/ui/logo",
          "size": [ 214, 48 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 8 ],
          "layer": 40
        }
      }
    ]
  },

  "bp_item_text_anchor": {
    "type": "panel",
    "size": [ 0, 0 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [ { "bp_item_text@hud.bp_item_text": {} } ]
  },

  "bp_item_text": {
    "type": "panel",
    "size": [ "100%c", 20 ],
    "anchor_from": "top_middle",
    "anchor_to": "bottom_middle",
    "offset": [ 0, -4 ],
    "clips_children": true,
    "controls": [
      {
        "bp_item_text_label": {
          "type": "label",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "max_size": [ 260, "default" ],
          "text_alignment": "center",
          "color": [ 1.0, 0.95, 0.75 ],
          "shadow": true,
          "layer": 31,
          "text": "#item_text",
          "bindings": [ { "binding_name": "#item_text" } ]
        }
      }
    ]
  }
}

{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minecade.gun.fire_tap": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "fire": "q.cooldown_time_remaining('slot.weapon.mainhand') > 0"
            }
          ]
        },
        "fire": {
          "animations": [
            "recoil"
          ],
          "transitions": [
            {
              "default": "!(q.cooldown_time_remaining('slot.weapon.mainhand') > 0)"
            }
          ]
        }
      }
    },
    "controller.animation.minecade.gun.fire_hold": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "fire": "q.is_using_item"
            }
          ]
        },
        "fire": {
          "animations": [
            "recoil"
          ],
          "transitions": [
            {
              "default": "!q.is_using_item"
            }
          ]
        }
      }
    }
  }
}

{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.minecade.holo_screen": {
      "arrays": {
        "textures": {
          "Array.screens": [
            "Texture.frame_logo",
            "Texture.frame_panel"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.screens[q.property('minecade:screen')]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "root": true
        },
        {
          "screen": true
        },
        {
          "panel_s": true
        },
        {
          "panel_e": true
        },
        {
          "panel_n": true
        },
        {
          "panel_w": true
        }
      ],
      "ignore_lighting": true
    },
    "controller.render.minecade.holo_picture": {
      "arrays": {
        "textures": {
          "Array.pictures": [
            "Texture.picture_0"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.pictures[q.property('minecade:picture')]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "root": true
        },
        {
          "screen": true
        },
        {
          "picture_s": "q.property('minecade:picture_spot') == 0"
        },
        {
          "picture_e": "q.property('minecade:picture_spot') == 0"
        },
        {
          "picture_n": "q.property('minecade:picture_spot') == 0"
        },
        {
          "picture_w": "q.property('minecade:picture_spot') == 0"
        },
        {
          "banner_s": "q.property('minecade:picture_spot') == 1"
        },
        {
          "banner_e": "q.property('minecade:picture_spot') == 1"
        },
        {
          "banner_n": "q.property('minecade:picture_spot') == 1"
        },
        {
          "banner_w": "q.property('minecade:picture_spot') == 1"
        }
      ],
      "ignore_lighting": true
    },
    "controller.render.minecade.holo_portrait": {
      "arrays": {
        "textures": {
          "Array.portraits": [
            "Texture.portrait_0"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.portraits[q.property('minecade:portrait')]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "root": true
        },
        {
          "screen": true
        },
        {
          "portrait_s": true
        },
        {
          "portrait_e": true
        },
        {
          "portrait_n": true
        },
        {
          "portrait_w": true
        }
      ],
      "ignore_lighting": true
    },
    "controller.render.minecade.holo_beam": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.beam"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "root": true
        },
        {
          "beam": true
        }
      ],
      "ignore_lighting": true
    }
  }
}

node_modules/
dist/
# The map editor's working files (its log, later the Select mode copies).
work/
.env
spike/dist/
spike/world/
spike/results/
# Captured skins are players' personal data; they stay on this PC.
spike/skins/out/
/skins/
*.tsbuildinfo
**/world.new/
# The maps and the games' pictures are in the map store beside the checkout (tools/maps), not in git.
/lobby/maps/
/games/*/maps/
/games/*/icon.png
# The shared blocks pack is generated from a private project and holds mod art that isn't ours to
# publish (see packs/blocks/README.md).
packs/blocks/behavior_pack/
packs/blocks/resource_pack/
# Minecraft's own textures, copied from the game on this PC for kit pictures (tools/build/vanilla-textures.ts);
# they're Mojang's, not ours to publish.
tools/assets/vanilla/
# The dyed leather armor pack is Minecraft's leather tinted: the build writes it (tools/assets/armor.ts).
packs/armor/behavior_pack/
packs/armor/resource_pack/
# A game's private test packs come from workshop projects outside the repo and hold files that
# aren't ours to publish (games/probe/private_packs/README.md).
/games/*/private_packs/*/

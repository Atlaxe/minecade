{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.blockparty.fading": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "v.fade < 1.0 ? Material.fade : Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "color": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": "v.fade"
      },
      "part_visibility": [
        {
          "*": "v.fade > 0.0"
        }
      ]
    },
    "controller.render.blockparty.bot": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.steve",
            "Texture.alex",
            "Texture.ari",
            "Texture.efe",
            "Texture.kai",
            "Texture.makena",
            "Texture.noor",
            "Texture.sunny",
            "Texture.zuri",
            "Texture.tennis_steve",
            "Texture.tuxedo_steve",
            "Texture.athlete_steve",
            "Texture.scottish_steve",
            "Texture.prisoner_steve",
            "Texture.cyclist_steve",
            "Texture.boxer_steve",
            "Texture.tennis_alex",
            "Texture.tuxedo_alex",
            "Texture.athlete_alex",
            "Texture.swedish_alex",
            "Texture.prisoner_alex",
            "Texture.cyclist_alex",
            "Texture.boxer_alex",
            "Texture.developer_alex",
            "Texture.developer_steve"
          ]
        },
        "geometries": {
          "Array.models": [
            "Geometry.default",
            "Geometry.slim",
            "Geometry.default",
            "Geometry.slim",
            "Geometry.default",
            "Geometry.slim",
            "Geometry.slim",
            "Geometry.slim",
            "Geometry.default",
            "Geometry.default",
            "Geometry.default",
            "Geometry.default",
            "Geometry.default",
            "Geometry.default",
            "Geometry.default",
            "Geometry.default",
            "Geometry.slim",
            "Geometry.slim",
            "Geometry.slim",
            "Geometry.slim",
            "Geometry.slim",
            "Geometry.slim",
            "Geometry.slim",
            "Geometry.slim",
            "Geometry.default"
          ]
        }
      },
      "geometry": "Array.models[v.skin]",
      "materials": [
        {
          "*": "v.fade < 1.0 ? Material.fade : Material.default"
        }
      ],
      "textures": [
        "Array.skins[v.skin]"
      ],
      "color": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": "v.fade"
      },
      "part_visibility": [
        {
          "*": "v.fade > 0.0"
        }
      ]
    },
    "controller.render.blockparty.villager_base": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.base"
      ]
    },
    "controller.render.blockparty.villager_masked": {
      "arrays": {
        "textures": {
          "Array.biomes": [
            "Texture.plains",
            "Texture.desert",
            "Texture.jungle",
            "Texture.savanna",
            "Texture.snow",
            "Texture.swamp",
            "Texture.taiga"
          ],
          "Array.professions": [
            "Texture.unskilled",
            "Texture.farmer",
            "Texture.fisherman",
            "Texture.shepherd",
            "Texture.fletcher",
            "Texture.librarian",
            "Texture.cartographer",
            "Texture.cleric",
            "Texture.armorer",
            "Texture.weapon_smith",
            "Texture.tool_smith",
            "Texture.butcher",
            "Texture.leatherworker",
            "Texture.stonemason",
            "Texture.nitwit"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "v.profession_index == 0 ? Material.default : Material.masked"
        }
      ],
      "textures": [
        "Array.biomes[v.biome_index]",
        "Array.professions[v.profession_index]"
      ]
    },
    "controller.render.blockparty.villager_level": {
      "arrays": {
        "textures": {
          "Array.levels": [
            "Texture.level_stone",
            "Texture.level_iron",
            "Texture.level_gold",
            "Texture.level_emerald",
            "Texture.level_diamond"
          ]
        }
      },
      "geometry": "Geometry.default",
      "part_visibility": [
        {
          "*": "v.profession_index != 0 && v.profession_index != 14"
        }
      ],
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.levels[v.level_index]"
      ]
    },
    "controller.render.blockparty.referee": {
      "geometry": "Geometry.default",
      "part_visibility": [
        {
          "rightArm": "v.cheer"
        },
        {
          "leftArm": "v.cheer"
        },
        {
          "rightItem": false
        },
        {
          "arms": "!v.cheer"
        }
      ],
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.blockparty.die": {
      "arrays": {
        "textures": {
          "Array.dice": [
            "Texture.default",
            "Texture.die_standard",
            "Texture.die_slow",
            "Texture.die_triple",
            "Texture.die_risk",
            "Texture.die_golden",
            "Texture.die_mystery",
            "Texture.die_cursed",
            "Texture.die_one"
          ]
        },
        "geometries": {
          "Array.bodies": [
            "Geometry.plain",
            "Geometry.plain",
            "Geometry.plain",
            "Geometry.plain",
            "Geometry.plain",
            "Geometry.plain",
            "Geometry.plain",
            "Geometry.plain",
            "Geometry.plain"
          ]
        }
      },
      "geometry": "Array.bodies[q.property('blockparty:die')]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.dice[q.property('blockparty:die')]"
      ]
    },
    "controller.render.blockparty.die_faces": {
      "arrays": {
        "geometries": {
          "Array.faces": [
            "Geometry.faces",
            "Geometry.faces_standard",
            "Geometry.faces_slow",
            "Geometry.faces_triple",
            "Geometry.faces_risk",
            "Geometry.faces_golden",
            "Geometry.faces_mystery",
            "Geometry.faces_cursed",
            "Geometry.faces_one"
          ]
        }
      },
      "geometry": "Array.faces[q.property('blockparty:die')]",
      "materials": [
        {
          "*": "Material.faces"
        }
      ],
      "textures": [
        "Texture.palette"
      ]
    },
    "controller.render.blockparty.space": {
      "arrays": {
        "textures": {
          "Array.types": [
            "Texture.type_start",
            "Texture.type_blue",
            "Texture.type_red",
            "Texture.type_item",
            "Texture.type_shop",
            "Texture.type_chance",
            "Texture.type_warden",
            "Texture.type_versus",
            "Texture.type_happening"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.types[q.property('blockparty:type')]"
      ],
      "part_visibility": [
        {
          "*": "!q.property('blockparty:lit')"
        }
      ]
    },
    "controller.render.blockparty.space_lit": {
      "arrays": {
        "textures": {
          "Array.types": [
            "Texture.type_start",
            "Texture.type_blue",
            "Texture.type_red",
            "Texture.type_item",
            "Texture.type_shop",
            "Texture.type_chance",
            "Texture.type_warden",
            "Texture.type_versus",
            "Texture.type_happening"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.types[q.property('blockparty:type')]"
      ],
      "part_visibility": [
        {
          "*": "q.property('blockparty:lit')"
        }
      ],
      "ignore_lighting": true,
      "overlay_color": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": "0.25 + 0.15 * math.sin(q.life_time * 300)"
      }
    },
    "controller.render.blockparty.token": {
      "arrays": {
        "geometries": {
          "Array.shapes": [
            "Geometry.icon",
            "Geometry.coin",
            "Geometry.star"
          ]
        },
        "textures": {
          "Array.looks": [
            "Texture.slot_0",
            "Texture.slot_1",
            "Texture.slot_2",
            "Texture.slot_3",
            "Texture.slot_4",
            "Texture.slot_5",
            "Texture.slot_6",

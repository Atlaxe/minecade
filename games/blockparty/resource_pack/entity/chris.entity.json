{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "blockparty:chris",
      "materials": {
        "default": "pig_v3",
        "balloon": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/pig/pig_v3",
        "warm": "textures/entity/pig/pig_warm",
        "cold": "textures/entity/pig/pig_cold",
        "baby_default": "textures/entity/pig/pig_temperate_baby",
        "baby_warm": "textures/entity/pig/pig_warm_baby",
        "baby_cold": "textures/entity/pig/pig_cold_baby",
        "balloon": "textures/blockparty/balloon"
      },
      "geometry": {
        "default": "geometry.pig.v3",
        "baby": "geometry.pig.baby",
        "balloon": "geometry.blockparty.balloon"
      },
      "render_controllers": [
        "controller.render.pig.v4",
        {
          "controller.render.blockparty.balloon": "v.balloon > 0.0"
        }
      ],
      "animations": {
        "setup": "animation.pig.setup",
        "look_at_target": "animation.common.look_at_target",
        "balloon": "animation.blockparty.balloon"
      },
      "scripts": {
        "pre_animation": [
          "v.index = q.property('blockparty:variant');",
          "v.balloon = math.clamp(v.balloon + (q.property('blockparty:balloon') ? 3.0 : -8.0) * q.delta_time, 0.0, 1.0);"
        ],
        "animate": [
          "setup",
          "look_at_target",
          "balloon"
        ],
        "initialize": [
          "v.balloon = 0.0;"
        ]
      }
    }
  }
}

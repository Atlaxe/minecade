{
  "namespace": "blockparty_dialogue",

  // Block Party's dialogue box (docs/plans/block-party-ui.md, "The dialogue box" and "Skip and
  // Ready"), bottom middle, the same for everyone. It reads the scoreboard sidebar while its title
  // starts with the game sidebar mark ('§r§m§g§r', GAME_SIDEBAR_MARK in minigame-core's hud.ts; the
  // core pack hides the vanilla sidebar for it): the title's code says who the box is for and its
  // text is the speaker's name; each participant is a row whose first code says what it is. The
  // codes are dialogue-codes.ts's (behavior_pack/scripts), and a test checks this file uses them:
  //   title   '§k§1' one player (the words, the buttons beside them), '§k§2' everyone (the words the
  //           whole width), '§k§8' it has a speaker's name
  //   rows    '§k§1' a sentence of the words, '§k§2' a button, '§k§3' the selected button,
  //           '§k§4' the skip strip (a tab on the box's top border, at the right)
  // Codes never render, so each row shows as its text, colors and all.
  //
  // The look is in the variables on "box" (sizes in screen units, colors 0 to 1), for the user or
  // their JSON UI tool to change; the controls below them only wire the rows in. A size or offset
  // variable is always the whole pair, [width, height] or [x, y]: the game rejects a variable as one
  // part of one ("Dangling number (no % or px in Size)" in the content log), and the control then
  // has no size (the box once drew only the speaker's name that way). The plain fills (the tabs, the
  // highlight) say "keep_ratio": false, or the game draws their square texture as a square.

  "box": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$box_size": [ 330, "100%cm + 16px" ],
    "$box_offset": [ 0, -12 ],
    "$buttons_size": [ 96, "100%c" ],
    "$button_size": [ "100%", 13 ],
    "$text_color": [ 1.0, 1.0, 1.0 ],
    "$name_color": [ 1.0, 1.0, 1.0 ],
    "$tab_color": [ 0.0, 0.0, 0.0 ],
    "$tab_alpha": 0.9,
    "$highlight_color": [ 0.282, 0.753, 0.941 ],
    "$highlight_alpha": 0.9,
    "$skip_color": [ 0.0, 0.0, 0.0 ],
    "$skip_alpha": 0.9,
    "visible": false,
    "bindings": [
      { "binding_name": "#scoreboard_sidebar_visible", "binding_type": "global" },
      { "binding_name": "#objective_sidebar_name", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "(#scoreboard_sidebar_visible and (not ((#objective_sidebar_name - '§r§m§g§r') = #objective_sidebar_name)))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "frame@blockparty_dialogue.frame": {} }
    ]
  },

  // The box: an outline round a see-through middle (a nine-slice), as tall as what's in it, with the
  // speaker's name on its top border at the left and the skip strip on it at the right.
  "frame": {
    "type": "image",
    "texture": "textures/blockparty/ui/dialogue_box",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": "$box_offset",
    "size": "$box_size",
    "layer": 20,
    "controls": [
      { "columns@blockparty_dialogue.columns": {} },
      { "name_tab@blockparty_dialogue.name_tab": {} },
      { "skip@blockparty_dialogue.skip_strip": {} }
    ]
  },

  // The words, then (said to one player) the buttons beside them.
  "columns": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ "100% - 16px", "100%cm" ],
    "controls": [
      {
        "words": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ "fill", "100%c" ],
          "collection_name": "scoreboard_players",
          "factory": { "name": "player_list_factory", "control_name": "blockparty_dialogue.sentence" },
          "bindings": [ { "binding_name": "#scoreboard_sidebar_size", "binding_type": "global", "binding_name_override": "#collection_length" } ]
        }
      },
      {
        "gap": {
          "type": "panel",
          "size": [ 6, 1 ],
          "visible": false,
          "bindings": [
            { "binding_name": "#objective_sidebar_name", "binding_type": "global" },
            { "binding_type": "view", "source_property_name": "(not ((#objective_sidebar_name - '§k§1') = #objective_sidebar_name))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "buttons": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": "$buttons_size",
          "visible": false,
          "collection_name": "scoreboard_players",
          "factory": { "name": "player_list_factory", "control_name": "blockparty_dialogue.button_row" },
          "bindings": [
            { "binding_name": "#scoreboard_sidebar_size", "binding_type": "global", "binding_name_override": "#collection_length" },
            { "binding_name": "#objective_sidebar_name", "binding_type": "global" },
            { "binding_type": "view", "source_property_name": "(not ((#objective_sidebar_name - '§k§1') = #objective_sidebar_name))", "target_property_name": "#visible" }
          ]
        }
      }
    ]
  },

  // One sentence (a row with '§k§1'), wrapping across the words' column.
  "sentence": {
    "type": "panel",
    "size": [ "100%", "100%c + 2px" ],
    "visible": false,
    "bindings": [
      { "binding_name": "#player_name_sidebar", "binding_type": "collection", "binding_collection_name": "scoreboard_players" },
      { "binding_type": "view", "source_property_name": "(not ((#player_name_sidebar - '§k§1') = #player_name_sidebar))", "target_property_name": "#visible" }
    ],
    "controls": [
      {
        "text": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ "100%", "default" ],
          "color": "$text_color",
          "layer": 22,
          "text": "#player_name_sidebar",
          "shadow": true,
          "localize": false,
          "bindings": [ { "binding_name": "#player_name_sidebar", "binding_type": "collection", "binding_collection_name": "scoreboard_players" } ]
        }
      }
    ]
  },

  // One button (a row with '§k§2', or '§k§3' while it's selected: the highlight behind it).
  "button_row": {
    "type": "panel",
    "size": "$button_size",
    "visible": false,
    "bindings": [
      { "binding_name": "#player_name_sidebar", "binding_type": "collection", "binding_collection_name": "scoreboard_players" },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#player_name_sidebar - '§k§2') = #player_name_sidebar)) or (not ((#player_name_sidebar - '§k§3') = #player_name_sidebar)))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "highlight": {
          "type": "image",
          "texture": "textures/blockparty/ui/white",
          "keep_ratio": false,
          "size": [ "100%", "100% - 1px" ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "color": "$highlight_color",
          "alpha": "$highlight_alpha",
          "layer": 21,
          "visible": false,
          "bindings": [
            { "binding_name": "#player_name_sidebar", "binding_type": "collection", "binding_collection_name": "scoreboard_players" },
            { "binding_type": "view", "source_property_name": "(not ((#player_name_sidebar - '§k§3') = #player_name_sidebar))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "text": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 4, 0 ],
          "size": [ "100% - 8px", "default" ],
          "color": "$text_color",
          "layer": 22,
          "text": "#player_name_sidebar",
          "shadow": true,
          "localize": false,
          "bindings": [ { "binding_name": "#player_name_sidebar", "binding_type": "collection", "binding_collection_name": "scoreboard_players" } ]
        }
      }
    ]
  },

  // The speaker's name on the top border, on a tab of its own (so the outline breaks there); none
  // for the game's own lines (no '§k§8').
  "name_tab": {
    "type": "image",
    "texture": "textures/blockparty/ui/white",
    "keep_ratio": false,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 8, -6 ],
    "size": [ "100%c + 8px", 11 ],
    "color": "$tab_color",
    "alpha": "$tab_alpha",
    "layer": 23,
    "visible": false,
    "bindings": [
      { "binding_name": "#objective_sidebar_name", "binding_type": "global" },
      { "binding_type": "view", "source_property_name": "(not ((#objective_sidebar_name - '§k§8') = #objective_sidebar_name))", "target_property_name": "#visible" }
    ],
    "controls": [
      {
        "name": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "color": "$name_color",
          "layer": 24,
          "text": "#objective_sidebar_name",
          "shadow": true,
          "localize": false,
          "bindings": [ { "binding_name": "#objective_sidebar_name", "binding_type": "global" } ]
        }
      }
    ]
  },

  // The skip strip (a row with '§k§4'): the words, then who's jumped to skip, on a tab of the box's
  // top border at the right, like the name's at the left.
  "skip_strip": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -8, -6 ],
    "size": [ 200, "100%c" ],
    "collection_name": "scoreboard_players",
    "factory": { "name": "player_list_factory", "control_name": "blockparty_dialogue.skip_row" },
    "bindings": [ { "binding_name": "#scoreboard_sidebar_size", "binding_type": "global", "binding_name_override": "#collection_length" } ]
  },

  "skip_row": {
    "type": "panel",
    "size": [ "100%", 11 ],
    "visible": false,
    "bindings": [
      { "binding_name": "#player_name_sidebar", "binding_type": "collection", "binding_collection_name": "scoreboard_players" },
      { "binding_type": "view", "source_property_name": "(not ((#player_name_sidebar - '§k§4') = #player_name_sidebar))", "target_property_name": "#visible" }
    ],
    "controls": [
      {
        "bubble": {
          "type": "image",
          "texture": "textures/blockparty/ui/white",
          "keep_ratio": false,
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "size": [ "100%c + 8px", 11 ],
          "color": "$skip_color",
          "alpha": "$skip_alpha",
          "layer": 23,
          "controls": [
            {
              "text": {
                "type": "label",
                "anchor_from": "center",
                "anchor_to": "center",
                "color": "$text_color",
                "layer": 1,
                "text": "#player_name_sidebar",
                "shadow": true,
                "localize": false,
                "bindings": [ { "binding_name": "#player_name_sidebar", "binding_type": "collection", "binding_collection_name": "scoreboard_players" } ]
              }
            }
          ]
        }
      }
    ]
  }
}

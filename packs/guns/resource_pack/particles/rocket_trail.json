{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "minecade:rocket_trail",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/minecade/guns/puff"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40,
        "max_particles": 60
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.08,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 0.2,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.9 + v.particle_random_1 * 0.4"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 + v.particle_age * 0.35",
          "0.12 + v.particle_age * 0.35"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1, 0.33, math.min(1, v.particle_age / v.particle_lifetime * 3))",
          "math.lerp(0.7, 0.32, math.min(1, v.particle_age / v.particle_lifetime * 3))",
          "math.lerp(0.3, 0.31, math.min(1, v.particle_age / v.particle_lifetime * 3))",
          "0.85 * (1 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}

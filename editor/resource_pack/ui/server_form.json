{
  "namespace": "server_form",

  // The map editor's menus. Forms whose title starts with a layout mark (formatting codes that never
  // render, see editor/behavior_pack/scripts/marks.ts) get a layout in editor_forms.json, button
  // forms and forms with fields alike; every other form stays vanilla. Merged into the vanilla file,
  // so updates to it still apply.
  //
  // Vanilla sizes this panel [0, 0] (its forms are fixed sizes centered on it), which makes every
  // percentage size inside it zero. Filling the screen lets the side menu take the screen's full
  // height; vanilla's forms stay the same, centered.
  "main_screen_content": {
    "size": ["100%", "100%"],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "editor_forms_factory_panel": {
            "type": "panel",
            "size": ["100%", "100%"],
            "factory": {
              "name": "server_form_factory",
              "control_ids": {
                "long_form": "@editor_forms.long_form",
                "custom_form": "@editor_forms.custom_form"
              }
            }
          }
        }
      }
    ]
  },

  // The vanilla action form hides itself for marked titles (the side mark, the map menu's, the icon
  // row layout's or the editor lobby's). Like every control a binding shows, it starts hidden, so a new form's first
  // frame (before the bindings) has nothing stale to click.
  "long_form": {
    "visible": false,
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "(((#title_text - '§s§i§d§e') = #title_text) and ((#title_text - '§m§a§p') = #title_text) and ((#title_text - '§h§o§m§e') = #title_text) and ((#title_text - '§i§c§o§n') = #title_text))",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  // A list in a form with fields (Export to Map's For) opens about five options tall before it
  // scrolls, not vanilla's three (its list is sized against the 30 pixel field: 200% there). The
  // rest is vanilla's, copied, since a child's own variables can't be changed from outside.
  "custom_dropdown": {
    "controls": [
      {
        "dropdown@settings_common.option_dropdown": {
          "$option_label": "#custom_text",
          "$dropdown_content": "server_form.custom_dropdown_content",
          "$dropdown_area": "inside_header_panel",
          "$dropdown_name": "custom_dropdown",
          "$toggle_binding_type": "collection",
          "$toggle_grid_collection_name": "custom_form",
          "$options_dropdown_toggle_label_binding": "#dropdown_option_text",
          "$options_dropdown_toggle_label_binding_type": "collection",
          "$options_dropdown_toggle_label_binding_collection_name": "custom_form",
          "$option_tooltip_binding_type": "collection",
          "$option_tooltip_collection_name": "custom_form",
          "$option_tooltip_text_binding_name": "#custom_tooltip_text",
          "$option_tooltip_area": "inside_header_panel",
          "$dropdown_scroll_content_size": ["100%", "333%"],
          "$label_bindings": [{"binding_name": "#custom_text", "binding_type": "collection", "binding_collection_name": "custom_form"}]
        }
      }
    ]
  },

  // The vanilla form with fields hides itself for a title with the side mark: editor_forms.json
  // draws those down the right side. Starts hidden, as above.
  "custom_form": {
    "visible": false,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text - '§s§i§d§e') = #title_text)",
        "target_property_name": "#visible"
      }
    ]
  }
}

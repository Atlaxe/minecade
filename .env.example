# Copy to .env and fill in. .env is gitignored.

# Required. TRUE means you accept the Minecraft EULA (https://www.minecraft.net/eula)
# and the Microsoft Privacy Policy. The Docker build refuses to download BDS without it.
EULA=

# Bedrock Dedicated Server version. Must match your players' client version.
BDS_VERSION=1.26.60.6

# Address remote friends use. "auto" looks up your public IP at container start
# (https://api.ipify.org). A DDNS hostname also works.
PUBLIC_HOST=auto

# Your PC's LAN IP. Players listed in LAN_PLAYERS are transferred here instead of PUBLIC_HOST.
LAN_HOST=192.168.40.98

# Comma-separated gamertags of players on your home network (at least your own).
LAN_PLAYERS=

# Comma-separated gamertags allowed to join. Empty means anyone with the address can join.
ALLOW_LIST=

# How packs talk to the orchestrator: http (server-net) or log (log lines + stdin).
TRANSPORT=http

# Dev only: override every game's minimum player count (e.g. 1 for solo testing).
DEV_MIN_PLAYERS=

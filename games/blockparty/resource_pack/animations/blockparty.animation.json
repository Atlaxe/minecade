{
  "format_version": "1.8.0",
  "animations": {
    "animation.blockparty.rest": {
      "animation_length": 0.05
    },
    "animation.blockparty.golem_hit": {
      "animation_length": 0.6,
      "bones": {
        "arm0": { "rotation": { "0.0": [0, 0, 0], "0.15": [-115, 0, -6], "0.3": [-100, 0, -6], "0.6": [0, 0, 0] } },
        "arm1": { "rotation": { "0.0": [0, 0, 0], "0.15": [-115, 0, 6], "0.3": [-100, 0, 6], "0.6": [0, 0, 0] } },
        "head": { "rotation": { "0.0": [0, 0, 0], "0.15": [10, 0, 0], "0.6": [0, 0, 0] } }
      }
    },
    "animation.blockparty.zombie_hit": {
      "animation_length": 0.5,
      "bones": {
        "rightarm": { "rotation": { "0.0": [0, 0, 0], "0.12": [-35, 0, 0], "0.28": [45, -10, 0], "0.5": [0, 0, 0] } },
        "leftarm": { "rotation": { "0.0": [0, 0, 0], "0.12": [-35, 0, 0], "0.28": [45, 10, 0], "0.5": [0, 0, 0] } },
        "body": { "rotation": { "0.0": [0, 0, 0], "0.28": [8, 0, 0], "0.5": [0, 0, 0] } }
      }
    },
    "animation.blockparty.referee_base": {
      "loop": true,
      "bones": {
        "arms": { "position": [0.0, "-3.0 - this", "-1.0 - this"], "rotation": ["-42.97 - this", 0.0, 0.0] }
      }
    },
    "animation.blockparty.referee_raise": {
      "loop": "hold_on_last_frame",
      "animation_length": 0.3,
      "bones": {
        "arms": {
          "rotation": { "0.0": ["-42.97 - this", 0, 0], "0.3": ["-137.0 - this", 0, 0] },
          "position": { "0.0": [0, "-3.0 - this", "-1.0 - this"], "0.3": [0, "-1.0 - this", "-2.0 - this"] }
        }
      }
    },
    "animation.blockparty.die_spin": {
      "loop": true,
      "bones": {
        "die": {
          "rotation": ["math.sin(q.life_time * 140) * 25", "q.life_time * 160", "math.cos(q.life_time * 110) * 20"],
          "position": [0, "math.sin(q.life_time * 200)", 0],
          "scale": "math.min(1, q.life_time * 5)"
        }
      }
    },
    "animation.blockparty.die_burst": {
      "loop": "hold_on_last_frame",
      "animation_length": 0.35,
      "bones": {
        "die": {
          "rotation": [
            "math.sin(q.life_time * 140) * 25 + math.random(-14, 14)",
            "q.life_time * 160 + q.anim_time * q.anim_time * 3000",
            "math.cos(q.life_time * 110) * 20 + math.random(-14, 14)"
          ],
          "position": ["math.random(-0.7, 0.7)", "math.sin(q.life_time * 200) + math.random(-0.7, 0.7)", "math.random(-0.7, 0.7)"],
          "scale": {
            "0.0": [1, 1, 1],
            "0.08": [1.35, 0.75, 1.35],
            "0.17": [0.9, 1.3, 0.9],
            "0.27": [1.45, 1.45, 1.45],
            "0.33": [1.7, 1.7, 1.7],
            "0.35": [0, 0, 0]
          }
        }
      }
    },
    "animation.blockparty.count_face": {
      "loop": true,
      "bones": {
        "upright": {
          "rotation": [0, "-q.body_y_rotation", 0]
        },
        "count": {
          "rotation": ["q.camera_rotation(0)", "q.camera_rotation(1)", 0]
        }
      }
    },
    "animation.blockparty.tally_rise": {
      "loop": true,
      "bones": {
        "upright": {
          "position": [0, "4 * (1 - math.pow(1 - math.min(1, q.life_time / 0.35), 2))", 0]
        }
      }
    },
    "animation.blockparty.count_pop": {
      "loop": true,
      "bones": {
        "count": {
          "position": [0, "math.sin(q.life_time * 180) * 0.5", 0],
          "scale": "math.min(1, q.life_time * 6) * (v.since < 0.1 ? 1 + v.since * 3.5 : (v.since < 0.25 ? 1.35 - (v.since - 0.1) * 2.33 : 1))"
        }
      }
    },
    "animation.blockparty.icon_turn": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [0, "q.life_time * 90", 0]
        }
      }
    },
    "animation.blockparty.hide": {
      "loop": true,
      "bones": {
        "root": {
          "scale": 0
        }
      }
    },
    "animation.blockparty.token.fly": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            "0",
            "0.16 * (q.property('blockparty:rise') * math.clamp(q.life_time / 0.7, 0, 1) + q.property('blockparty:arc') * 4 * math.clamp(q.life_time / 0.7, 0, 1) * (1 - math.clamp(q.life_time / 0.7, 0, 1)))",
            "0.16 * q.property('blockparty:reach') * (0.5 - math.clamp(q.life_time / 0.7, 0, 1))"
          ],
          "rotation": [
            0,
            "q.life_time * 540",
            0
          ],
          "scale": "0.55 * math.clamp(q.life_time / 0.08, 0, 1) * math.clamp((0.85 - q.life_time) / 0.12, 0, 1)"
        }
      }
    },
    "animation.blockparty.balloon": {
      "loop": true,
      "bones": {
        "balloon": {
          "rotation": ["math.cos(q.life_time * 80.0) * 4.0", 0, "math.sin(q.life_time * 100.0) * 6.0"],
          "scale": "v.balloon + math.sin(v.balloon * 180.0) * 0.4"
        }
      }
    },
    "animation.blockparty.star_hover": {
      "loop": true,
      "bones": {
        "root": {
          "position": [0, "math.sin(q.life_time * 120.0) * 1.5", 0],
          "scale": "1.5 * math.min(1.0, q.life_time * 4.0) * (1.5 - v.fade * 0.5)"
        }
      }
    }
  }
}

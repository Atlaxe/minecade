{
  "namespace": "server_form",

  // Minecade's themed menus. Forms whose title starts with a layout mark (formatting codes that
  // never render, see lobby/behavior_pack/scripts/menus.ts) get a layout from minecade_forms.json;
  // every other form stays vanilla. Merged into the vanilla file, so updates to it still apply.
  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "minecade_forms_factory_panel": {
            "type": "panel",
            "factory": {
              "name": "server_form_factory",
              "control_ids": {
                "long_form": "@minecade_forms.long_form"
              }
            }
          }
        }
      }
    ]
  },

  // The vanilla action form hides itself for marked titles.
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§m§a§i§n') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  }
}

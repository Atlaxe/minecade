{
  "namespace": "minecade_forms",

  // Every Minecade layout lives in here; each shows only for its own title mark (menus.ts).
  //
  // Columns of buttons: a stack_panel factory over "form_buttons" makes an item for every button,
  // and each item shows only if its text carries the column's marker (game-screen.ts MARK). A
  // hidden item takes no space in a stack panel, so several columns can share the same buttons in
  // any order. Markers are formatting codes ending in §r, so labels show the text as is.
  //
  // This panel fills the form's screen area (the menus inside are centered), so a menu can size
  // itself against the screen, like the game grid at 80% of its height.
  "long_form": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      { "main_menu@minecade_forms.main_menu": {} },
      { "games_menu@minecade_forms.games_menu": {} },
      { "game_menu@minecade_forms.game_menu": {} }
    ]
  },

  // ---- Shared pieces ---------------------------------------------------------------------------

  // Back one step: the close button, with vanilla's back arrow, top left. Same as Esc.
  "back_arrow@common.close_button": {
    "layer": 6,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "$close_button_offset": [6, 6],
    "controls": [
      { "default@common.close_button_panel": { "$close_button_texture": "textures/ui/back_button_default" } },
      { "hover@common.close_button_panel": { "$close_button_texture": "textures/ui/back_button_hover" } },
      { "pressed@common.close_button_panel": { "$close_button_texture": "textures/ui/back_button_pressed" } }
    ]
  },

  // A scroll area like the vanilla form's.
  "scroll@common.scrolling_panel": {
    "$show_background": false,
    "$scroll_size": [5, "100% - 4px"],
    "$scrolling_pane_size": ["100% - 4px", "100% - 2px"],
    "$scrolling_pane_offset": [2, 0],
    "$scroll_bar_right_padding_size": [0, 0]
  },

  // A column of buttons (see the top of this file).
  "button_column": {
    "type": "stack_panel",
    "orientation": "vertical",
    "collection_name": "form_buttons",
    "bindings": [{ "binding_name": "#form_button_contents", "binding_name_override": "#collection_length" }]
  },

  // The form button's picture (its icon path), stretched to the control's size.
  "button_picture": {
    "type": "image",
    "fill": true,
    "keep_ratio": false,
    "bilinear": true,
    "bindings": [
      { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "button_icon@minecade_forms.button_picture": {
    "layer": 2,
    "bilinear": false
  },

  "button_label": {
    "type": "label",
    "text": "#form_button_text",
    "color": [0.86, 0.96, 1.0],
    "shadow": true,
    "layer": 2,
    "bindings": [{ "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" }]
  },

  // Shown only while the button's text carries $state_mark (such as the chosen map's outline).
  "button_state_image": {
    "type": "image",
    "fill": true,
    "keep_ratio": false,
    "$state_mark|default": "",
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - $state_mark) = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // A button face: one picture, stretched.
  "face": {
    "type": "image",
    "texture": "$tile_texture",
    "size": ["100%", "100%"],
    "fill": true,
    "keep_ratio": false
  },

  // ---- The main menu ---------------------------------------------------------------------------
  // The logo, and Play and Stats side by side under it.
  "main_menu": {
    "type": "panel",
    "size": [300, 116],
    "layer": 2,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§m§a§i§n') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "background": { "type": "image", "texture": "textures/minecade/ui/panel", "size": ["100%", "100%"], "layer": 1 } },
      {
        "logo": {
          "type": "image",
          "texture": "textures/minecade/ui/logo",
          "size": [232, 50],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 10],
          "layer": 3
        }
      },
      {
        "tiles": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": ["100%c", 38],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0, -12],
          "layer": 3,
          "factory": {
            "name": "buttons",
            "control_ids": { "button": "@minecade_forms.tile_button" }
          },
          "collection_name": "form_buttons",
          "bindings": [{ "binding_name": "#form_button_contents", "binding_name_override": "#collection_length" }]
        }
      },
      { "back@minecade_forms.back_arrow": {} }
    ]
  },

  // A wide, short tile: icon on the left, label beside it. Hover and pressed states brighten it.
  "tile_button": {
    "type": "panel",
    "size": [140, 38],
    "controls": [
      {
        "button@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [136, 34],
          "bindings": [{ "binding_type": "collection_details", "binding_collection_name": "form_buttons" }],
          "controls": [
            { "default@minecade_forms.tile_face": { "$tile_texture": "textures/minecade/ui/tile_default" } },
            { "hover@minecade_forms.tile_face": { "$tile_texture": "textures/minecade/ui/tile_hover" } },
            { "pressed@minecade_forms.tile_face": { "$tile_texture": "textures/minecade/ui/tile_pressed" } }
          ]
        }
      }
    ]
  },

  "tile_face": {
    "type": "image",
    "texture": "$tile_texture",
    "size": ["100%", "100%"],
    "controls": [
      {
        "icon@minecade_forms.button_icon": {
          "size": [20, 20],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [9, 0]
        }
      },
      {
        "label@minecade_forms.button_label": {
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [36, 0]
        }
      }
    ]
  },

  // ---- Play: the game grid ---------------------------------------------------------------------
  // Three columns of wide cards (16:9 picture left, name and player count right), scrolling.
  // 80% of the screen's height; the background is a nine-slice, so its border keeps its size.
  "games_menu": {
    "type": "panel",
    "size": [430, "80%"],
    "layer": 2,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§g§r§i§d') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "background": { "type": "image", "texture": "textures/minecade/ui/panel_grid", "size": ["100%", "100%"], "layer": 1 } },
      {
        "heading": {
          "type": "label",
          "text": "Choose a game",
          "color": [0.62, 0.86, 1.0],
          "shadow": true,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 11],
          "layer": 3
        }
      },
      {
        "games@minecade_forms.scroll": {
          "size": ["100% - 10px", "100% - 44px"],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 34],
          "layer": 3,
          "$scrolling_content": "minecade_forms.games_columns"
        }
      },
      { "back@minecade_forms.back_arrow": {} }
    ]
  },

  "games_columns": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%c", "100%cm"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "column_1@minecade_forms.games_column_1": {} },
      { "column_2@minecade_forms.games_column_2": {} },
      { "column_3@minecade_forms.games_column_3": {} }
    ]
  },

  "games_column_1@minecade_forms.button_column": { "size": [136, "100%c"], "factory": { "name": "buttons", "control_ids": { "button": "@minecade_forms.game_card_1" } } },
  "games_column_2@minecade_forms.button_column": { "size": [136, "100%c"], "factory": { "name": "buttons", "control_ids": { "button": "@minecade_forms.game_card_2" } } },
  "games_column_3@minecade_forms.button_column": { "size": [136, "100%c"], "factory": { "name": "buttons", "control_ids": { "button": "@minecade_forms.game_card_3" } } },

  "game_card_1@minecade_forms.game_card": { "$card_mark": "§q§1§r" },
  "game_card_2@minecade_forms.game_card": { "$card_mark": "§q§2§r" },
  "game_card_3@minecade_forms.game_card": { "$card_mark": "§q§3§r" },

  // The label is the name and, on the second line, the player icon (a font glyph) and count.
  "game_card": {
    "type": "panel",
    "size": [136, 48],
    "$card_mark|default": "",
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - $card_mark) = #form_button_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "button@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [132, 44],
          "bindings": [{ "binding_type": "collection_details", "binding_collection_name": "form_buttons" }],
          "controls": [
            { "default@minecade_forms.face": { "$tile_texture": "textures/minecade/ui/card_default" } },
            { "hover@minecade_forms.face": { "$tile_texture": "textures/minecade/ui/card_hover" } },
            { "pressed@minecade_forms.face": { "$tile_texture": "textures/minecade/ui/card_pressed" } }
          ]
        }
      },
      {
        "picture@minecade_forms.button_picture": {
          "size": [60, 34],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [7, 0],
          "layer": 4
        }
      },
      {
        "label@minecade_forms.button_label": {
          "size": [58, "default"],
          "font_scale_factor": 0.85,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [72, 0],
          "layer": 4
        }
      }
    ]
  },

  // ---- Play: one game's screen -----------------------------------------------------------------
  // Left: the game's name and info, the Random map switch, its settings, and Start pinned to the
  // bottom. Right: two scrolling columns of map tiles (dimmed while Random is on).
  "game_menu": {
    "type": "panel",
    "size": [460, 250],
    "layer": 2,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§g§a§m§e') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "background": { "type": "image", "texture": "textures/minecade/ui/panel_game", "size": ["100%", "100%"], "layer": 1 } },
      {
        "details": {
          "type": "panel",
          "size": [210, 210],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [12, 30],
          "layer": 3,
          "controls": [
            {
              "top": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": ["100%", "100%c"],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "controls": [
                  {
                    "name": {
                      "type": "label",
                      "text": "#title_text",
                      "color": [0.86, 0.96, 1.0],
                      "shadow": true,
                      "font_scale_factor": 1.4,
                      "size": ["100%", "default"],
                      "bindings": [{ "binding_name": "#title_text" }]
                    }
                  },
                  { "gap": { "type": "panel", "size": ["100%", 4] } },
                  {
                    "info": {
                      "type": "label",
                      "text": "#form_text",
                      "color": [0.62, 0.86, 1.0],
                      "size": ["100%", "default"]
                    }
                  },
                  { "gap_settings": { "type": "panel", "size": ["100%", 8] } },
                  { "random@minecade_forms.toggle_column": {} },
                  { "settings@minecade_forms.settings_column": {} }
                ]
              }
            },
            { "start@minecade_forms.start_column": { "size": ["100%", 32], "anchor_from": "bottom_left", "anchor_to": "bottom_left" } }
          ]
        }
      },
      {
        "maps": {
          "type": "panel",
          "size": [226, 234],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [-8, 8],
          "layer": 3,
          "controls": [
            {
              "heading": {
                "type": "label",
                "text": "Maps",
                "color": [0.62, 0.86, 1.0],
                "shadow": true,
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [0, 4]
              }
            },
            {
              "tiles@minecade_forms.scroll": {
                "size": ["100%", "100% - 24px"],
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "$scrolling_content": "minecade_forms.map_columns"
              }
            }
          ]
        }
      },
      { "back@minecade_forms.back_arrow": {} }
    ]
  },

  "map_columns": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%c", "100%cm"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "column_a@minecade_forms.map_column_a": {} },
      { "column_b@minecade_forms.map_column_b": {} }
    ]
  },

  "map_column_a@minecade_forms.button_column": { "size": [108, "100%c"], "factory": { "name": "buttons", "control_ids": { "button": "@minecade_forms.map_tile_a" } } },
  "map_column_b@minecade_forms.button_column": { "size": [108, "100%c"], "factory": { "name": "buttons", "control_ids": { "button": "@minecade_forms.map_tile_b" } } },

  "map_tile_a@minecade_forms.map_tile": { "$tile_mark": "§m§1§r" },
  "map_tile_b@minecade_forms.map_tile": { "$tile_mark": "§m§2§r" },

  // The map's 16:9 preview inside the frame's 2 pixel border, a dark fade with the white name
  // over it, a dark cover while Random is on, and on top a transparent button whose states draw
  // only the frame (outlined white when chosen).
  "map_tile": {
    "type": "panel",
    "size": [108, 62],
    "$tile_mark|default": "",
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - $tile_mark) = #form_button_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "picture@minecade_forms.button_picture": { "size": [100, 54], "layer": 1 } },
      {
        "shade": {
          "type": "image",
          "texture": "textures/minecade/ui/fade_bottom",
          "size": [100, 28],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0, -4],
          "fill": true,
          "keep_ratio": false,
          "layer": 2
        }
      },
      {
        "label@minecade_forms.button_label": {
          "color": [1.0, 1.0, 1.0],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [8, -7],
          "layer": 3
        }
      },
      { "dim@minecade_forms.button_state_image": { "texture": "textures/minecade/ui/tile_dim", "size": [100, 54], "layer": 4, "$state_mark": "§d§m§r" } },
      {
        "button@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [104, 58],
          "layer": 5,
          "bindings": [{ "binding_type": "collection_details", "binding_collection_name": "form_buttons" }],
          "controls": [
            { "default@minecade_forms.face": { "$tile_texture": "textures/minecade/ui/tile_map_default" } },
            { "hover@minecade_forms.face": { "$tile_texture": "textures/minecade/ui/tile_map_hover" } },
            { "pressed@minecade_forms.face": { "$tile_texture": "textures/minecade/ui/tile_map_pressed" } }
          ]
        }
      },
      { "selected@minecade_forms.button_state_image": { "texture": "textures/minecade/ui/tile_map_selected", "size": [104, 58], "layer": 6, "$state_mark": "§s§e§l§r" } }
    ]
  },

  // The Random map switch, the settings (as many as the game has) and Start: full-width buttons
  // in their own columns. Start's column is one button tall, so it stays pinned to the bottom.
  "toggle_column@minecade_forms.button_column": { "size": ["100%", "100%c"], "factory": { "name": "buttons", "control_ids": { "button": "@minecade_forms.toggle_slot" } } },
  "settings_column@minecade_forms.button_column": { "size": ["100%", "100%c"], "factory": { "name": "buttons", "control_ids": { "button": "@minecade_forms.setting_slot" } } },
  "start_column@minecade_forms.button_column": { "size": ["100%", "100%c"], "factory": { "name": "buttons", "control_ids": { "button": "@minecade_forms.start_slot" } } },

  "toggle_slot@minecade_forms.wide_slot": { "$slot_mark": "§t§g§r", "$slot_face": "minecade_forms.toggle_face" },
  "setting_slot@minecade_forms.wide_slot": { "$slot_mark": "§c§t§r" },
  "start_slot@minecade_forms.wide_slot": { "$slot_mark": "§s§t§r" },

  "wide_slot": {
    "type": "panel",
    "size": ["100%", 32],
    "$slot_mark|default": "",
    "$slot_face|default": "minecade_forms.wide_button_face",
    "bindings": [
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - $slot_mark) = #form_button_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "button@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": ["100%", 28],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [{ "binding_type": "collection_details", "binding_collection_name": "form_buttons" }],
          "controls": [
            { "default@$slot_face": { "$tile_texture": "textures/minecade/ui/button_default" } },
            { "hover@$slot_face": { "$tile_texture": "textures/minecade/ui/button_hover" } },
            { "pressed@$slot_face": { "$tile_texture": "textures/minecade/ui/button_pressed" } }
          ]
        }
      }
    ]
  },

  "wide_button_face": {
    "type": "image",
    "texture": "$tile_texture",
    "size": ["100%", "100%"],
    "fill": true,
    "keep_ratio": false,
    "controls": [{ "label@minecade_forms.button_label": { "anchor_from": "center", "anchor_to": "center" } }]
  },

  // The switch: the label on the left, and an on or off switch on the right.
  "toggle_face": {
    "type": "image",
    "texture": "$tile_texture",
    "size": ["100%", "100%"],
    "fill": true,
    "keep_ratio": false,
    "controls": [
      { "label@minecade_forms.button_label": { "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [10, 0] } },
      {
        "off": {
          "type": "image",
          "texture": "textures/minecade/ui/toggle_off",
          "size": [26, 13],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-8, 0],
          "layer": 2,
          "bindings": [
            { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            {
              "binding_type": "view",
              "source_property_name": "((#form_button_text - '§o§n§r') = #form_button_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "on@minecade_forms.button_state_image": {
          "texture": "textures/minecade/ui/toggle_on",
          "size": [26, 13],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-8, 0],
          "layer": 2,
          "$state_mark": "§o§n§r"
        }
      }
    ]
  }
}

{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "blockparty:count",
      "materials": {
        "default": "entity_emissive"
      },
      "textures": {
        "default": "textures/blockparty/number_palette"
      },
      "geometry": {
        "default": "geometry.blockparty.count"
      },
      "render_controllers": [
        "controller.render.blockparty.count"
      ],
      "animations": {
        "face": "animation.blockparty.count_face",
        "pop": "animation.blockparty.count_pop"
      },
      "scripts": {
        "initialize": [
          "v.was = -1;",
          "v.since = 0;"
        ],
        "pre_animation": [
          "v.since = q.property('blockparty:count') == v.was ? v.since + q.delta_time : 0;",
          "v.was = q.property('blockparty:count');"
        ],
        "animate": [
          "face",
          "pop"
        ]
      }
    }
  }
}

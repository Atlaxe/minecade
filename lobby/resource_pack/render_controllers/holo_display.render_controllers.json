{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.minecade.holo_screen": {
      "arrays": {
        "textures": {
          "Array.screens": [
            "Texture.idle",
            "Texture.main",
            "Texture.main_play",
            "Texture.main_stats",
            "Texture.games",
            "Texture.game"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.screens[q.property('minecade:screen')]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "root": true
        },
        {
          "screen": true
        },
        {
          "panel_s": true
        },
        {
          "panel_e": true
        },
        {
          "panel_n": true
        },
        {
          "panel_w": true
        }
      ],
      "ignore_lighting": true
    },
    "controller.render.minecade.holo_icon": {
      "arrays": {
        "textures": {
          "Array.icons": [
            "Texture.icon_none"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.icons[q.property('minecade:game')]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "root": true
        },
        {
          "screen": true
        },
        {
          "icon_s": true
        },
        {
          "icon_e": true
        },
        {
          "icon_n": true
        },
        {
          "icon_w": true
        }
      ],
      "ignore_lighting": true
    },
    "controller.render.minecade.holo_beam": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.beam"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "root": true
        },
        {
          "beam": true
        }
      ],
      "ignore_lighting": true
    }
  }
}

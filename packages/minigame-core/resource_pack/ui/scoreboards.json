{
  "namespace": "scoreboard",

  // A sidebar whose title is the notes mark ('§r§m§n§r', NOTES_MARK in
  // packages/minigame-core/src/hud.ts) isn't drawn as the vanilla sidebar: hud_screen.json shows
  // its lines top left as notes (mc_notes). Any other sidebar shows as vanilla's.
  "scoreboard_sidebar": {
    "visible": false,
    "bindings": [
      { "binding_name": "#objective_sidebar_name", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "((#objective_sidebar_name - '§r§m§n§r') = #objective_sidebar_name)",
        "target_property_name": "#visible"
      }
    ]
  }
}

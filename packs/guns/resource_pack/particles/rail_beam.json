{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "minecade:rail_beam",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/minecade/guns/puff"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(v.dist * 4, 480)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "v.dir.x",
          "v.dir.y",
          "v.dir.z"
        ]
      },
      "minecraft:particle_initial_speed": "v.dist * 25 * v.particle_random_1",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + v.particle_random_2 * 0.3"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 25
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 * (1 - v.particle_age / v.particle_lifetime) + 0.02",
          "0.12 * (1 - v.particle_age / v.particle_lifetime) + 0.02"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.35,
          0.9,
          1,
          1
        ]
      }
    }
  }
}

{
  "namespace": "hud",

  // Block Party's hotbar (the plan's "Turns and controls"): vanilla's hotbar restyled, not hidden
  // and replaced, so scrolling, number keys, a controller's bumpers and tapping a slot on a touch
  // screen all still pick a slot. Each slot gets the game's tile (textures/blockparty/hud/slot,
  // drawn by tools/assets/blockparty-hud.py) in place of vanilla's gray slot art, the selected slot a
  // gold frame, and the selected item's name and what it does (its lore) show over the bar and stay.
  // Only Block Party's servers load this pack; each change below is a modification of vanilla's own
  // definition rather than a copy of it.
  //
  // After the user's second look:
  //   - The bar sits bottom right (the panels that hold it, anchored there; hearts, hunger and the
  //     XP bar in them are hidden by the game).
  //   - Only the slots in use show. An empty slot can't be told by its item (#item_id_aux didn't
  //     work), so the game gives every item it puts in the bar a count of 2, and a slot shows its
  //     tile, and its frame when selected, only while vanilla says its count shows
  //     (#stack_count_visible, the binding vanilla's own count label goes by). The count itself
  //     is hidden ($stack_count_required false). The game fills the rightmost slots, so what shows
  //     hugs the screen's edge, and moves a selection that lands on an empty slot on to the next one
  //     in use (spike.ts, keepHotbars).
  //   - Vanilla's name popup is gone: the name showed twice, once in it and once over the bar.

  // Vanilla's gray slots: the desktop bar draws them in one piece behind the grid, the touch bar
  // one a slot; and the caps at the bar's ends.
  "hotbar_slots_renderer": { "ignored": true },
  "hotbar_renderer": { "ignored": true },
  "hotbar_start_cap": { "ignored": true },
  "hotbar_end_cap": { "ignored": true },

  // Vanilla's popup of the selected item's name (also the core pack's one-line version of it).
  "item_name_text_root": { "ignored": true },

  // Bottom right instead of bottom middle: the desktop and the touch layouts' bottom panels.
  "centered_gui_elements_at_bottom_middle": { "anchor_from": "bottom_right", "anchor_to": "bottom_right", "offset": [ -4, 0 ] },
  "centered_gui_elements_at_bottom_middle_touch": { "anchor_from": "bottom_right", "anchor_to": "bottom_right", "offset": [ -4, 0 ] },

  "hotbar_slot_selected_image": {
    "texture": "textures/blockparty/hud/selected",
    "size": [ 24, 24 ],
    "visible": false,
    "bindings": [
      { "binding_name": "#slot_selected", "binding_type": "collection", "binding_collection_name": "$hotbar_collection_name" },
      { "binding_name": "#stack_count_visible", "binding_type": "collection", "binding_collection_name": "$hotbar_collection_name" },
      { "binding_type": "view", "source_property_name": "(#slot_selected and #stack_count_visible)", "target_property_name": "#visible" }
    ]
  },

  "gui_hotbar_grid_item": {
    "$stack_count_required": false,
    "modifications": [
      { "array_name": "controls", "operation": "insert_front", "value": [ { "bp_slot@hud.bp_slot": {} } ] }
    ]
  },
  "gui_hotbar_grid_item_pocket": {
    "$stack_count_required": false,
    "modifications": [
      { "array_name": "controls", "operation": "insert_front", "value": [ { "bp_slot@hud.bp_slot": { "size": [ "100%", "100%" ] } } ] }
    ]
  },

  // The name and what it does, over the bar's right end: a zero-size anchor keeps the label from
  // widening the grid, so the slots never move.
  "hotbar_grid_frame": {
    "modifications": [
      { "array_name": "controls", "operation": "insert_back", "value": [ { "bp_item_text_anchor@hud.bp_item_text_anchor": {} } ] }
    ]
  },

  "bp_slot": {
    "type": "image",
    "texture": "textures/blockparty/hud/slot",
    "size": [ 20, 22 ],
    "layer": 1,
    "visible": false,
    "bindings": [
      { "binding_name": "#stack_count_visible", "binding_name_override": "#visible", "binding_type": "collection", "binding_collection_name": "$hotbar_collection_name" }
    ]
  },

  "bp_item_text_anchor": {
    "type": "panel",
    "size": [ 0, 0 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "controls": [ { "bp_item_text@hud.bp_item_text": {} } ]
  },

  "bp_item_text": {
    "type": "panel",
    "size": [ "100%c", 20 ],
    "anchor_from": "top_right",
    "anchor_to": "bottom_right",
    "offset": [ 0, -4 ],
    "clips_children": true,
    "controls": [
      {
        "bp_item_text_label": {
          "type": "label",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "max_size": [ 260, "default" ],
          "text_alignment": "right",
          "color": [ 1.0, 0.95, 0.75 ],
          "shadow": true,
          "layer": 31,
          "text": "#item_text",
          "bindings": [ { "binding_name": "#item_text" } ]
        }
      }
    ]
  },

  // The loading screen while an arena loads (spike.ts, behindBlack): Minecade's star field (the
  // network's own world loading screen) with the logo in the middle, over everything, while the
  // action bar holds LOADING_CODE ('§k§d', after the core's HUD mark, so nothing else shows). The
  // core pack makes the action bar a full-screen panel (packages/minigame-core's hud_screen.json),
  // and this rides in it like the gun scope. A camera fade covers the HUD, so the game shows it
  // under black and fades the black away to reveal it.
  "hud_actionbar_text": {
    "modifications": [
      { "array_name": "controls", "operation": "insert_back", "value": [ { "bp_loading@hud.bp_loading": {} } ] }
    ]
  },

  "bp_loading": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 60,
    "$atext": "$actionbar_text",
    "visible": "(not (($atext - '§k§d') = $atext))",
    "controls": [
      { "bp_loading_black": { "type": "image", "texture": "textures/minecade/hud/black", "size": [ "100%", "100%" ], "keep_ratio": false, "layer": 60 } },
      { "bp_loading_stars": { "type": "image", "texture": "textures/minecade/sky/stars", "size": [ "100%", "100%" ], "tiled": true, "tiled_scale": [ 1, 1 ], "layer": 61 } },
      { "bp_loading_logo": { "type": "image", "texture": "textures/minecade/ui/logo", "size": [ 268, 60 ], "anchor_from": "center", "anchor_to": "center", "layer": 62 } }
    ]
  }
}

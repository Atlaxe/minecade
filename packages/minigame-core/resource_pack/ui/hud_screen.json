{
  "namespace": "hud",

  // The HUD top right. Bedrock has no script API for HUD text, so games send it on the action bar,
  // starting with a mark made of formatting codes that never render (HUD_MARK in
  // packages/minigame-core/src/hud.ts). The action bar becomes a full-screen panel: marked lines
  // show top right, each thing in a bubble of its own, and anything else shows exactly like the
  // vanilla action bar. A new thing there gets its own bubble too (docs/ui.md).
  //
  // Only the line's text is visible ("Lives: 2", Build Swap's prompt): it shows in a bubble above
  // the others when the line has the text code ('§k§c'), wrapping when it's long. Everything else
  // rides at the end of the line as more formatting codes (hud.ts), side by side under it:
  //   - the clock (clockCodes: "§k§n§2§k§p§5§k§a§3§r" is 2:53, '§k§b' first for red): a clock icon
  //     and its digits, ui/minecade_clock.json, generated by tools/assets/clock-hud.ts;
  //   - the player's own score (One in the Quiver's kills; countCodes: "§k§t§1§k§u§5§r" is 15): a
  //     skull and its digits, left of the clock's;
  //   - best-of rounds (bestOfCodes), left of the others: ui/minecade_rounds.json, generated by
  //     tools/assets/rounds-hud.ts.
  //
  // What JSON UI allows here, tested in-game on 26.60 (see docs/ui.md):
  //   - engine variables such as $actionbar_text work in expressions only after being copied
  //     into the control's own variable ("$atext": "$actionbar_text");
  //   - string subtraction works in "visible" checks, but doesn't produce text;
  //   - view bindings need a #property, so they can't read $atext alone.
  // A pack's def is merged into vanilla's, so it keeps vanilla's type (an image) and its texture
  // property, here a clear one; another type logs vanilla's texture as unknown.
  "hud_actionbar_text": {
    "type": "image",
    "texture": "textures/minecade/hud/clear",
    "size": [ "100%", "100%" ],
    "offset": [ 0, 0 ],
    "alpha": 1.0,
    "propagate_alpha": false,
    "controls": [
      { "mc_scope@hud.mc_scope": {} },
      { "mc_actionbar_plain@hud.mc_actionbar_plain": {} },
      { "mc_hud_stack@hud.mc_hud_stack": {} }
    ]
  },

  // A gun's scope while it's raised to aim (SCOPE_CODE in hud.ts, '§k§l', anywhere in the line):
  // the round lens (textures/minecade/hud/scope, from tools/assets/scope-hud.ts) as tall as the
  // screen in the middle, and black either side of it out to the edges, so it fits any shape of
  // screen ("%y" is a share of the control's own height, the screen's here). First, so the HUD's
  // bubbles show over it.
  "mc_scope": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$atext": "$actionbar_text",
    "visible": "(not (($atext - '§k§l') = $atext))",
    "controls": [
      {
        "mc_scope_lens": {
          "type": "image",
          "texture": "textures/minecade/hud/scope",
          "size": [ "100%y", "100%" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "keep_ratio": false
        }
      },
      {
        "mc_scope_left": {
          "type": "image",
          "texture": "textures/minecade/hud/black",
          "size": [ "50%", "100%" ],
          "anchor_from": "center",
          "anchor_to": "right",
          "offset": [ "-50%y + 1px", 0 ],
          "keep_ratio": false
        }
      },
      {
        "mc_scope_right": {
          "type": "image",
          "texture": "textures/minecade/hud/black",
          "size": [ "50%", "100%" ],
          "anchor_from": "center",
          "anchor_to": "left",
          "offset": [ "50%y - 1px", 0 ],
          "keep_ratio": false
        }
      }
    ]
  },

  // No mark: the vanilla action bar.
  "mc_actionbar_plain": {
    "type": "image",
    "$atext": "$actionbar_text",
    "size": [ "100%c + 12px", "100%c + 5px" ],
    "offset": [ 0, "50%-68px" ],
    "texture": "textures/ui/hud_tip_text_background",
    "alpha": "@hud.anim_actionbar_text_background_alpha_out",
    "visible": "(($atext - '§r§m§c§r') = $atext)",
    "controls": [
      {
        "actionbar_message": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "color": "$tool_tip_text",
          "enable_profanity_filter": true,
          "layer": 31,
          "text": "$actionbar_text",
          "shadow": true,
          "localize": false,
          "alpha": "@hud.anim_actionbar_text_alpha_out"
        }
      }
    ]
  },

  // Marked: top right, the text's bubble (when the line has text) over the row of the others. Each
  // sits in a full-width slot, against its right edge.
  "mc_hud_stack": {
    "type": "stack_panel",
    "orientation": "vertical",
    "$atext": "$actionbar_text",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -4, 4 ],
    "size": [ "100% - 8px", "100%c" ],
    "visible": "(not (($atext - '§r§m§c§r') = $atext))",
    "controls": [
      {
        "mc_text_slot": {
          "type": "panel",
          "$atext": "$actionbar_text",
          "size": [ "100%", "100%c" ],
          "ignored": "(($atext - '§k§c') = $atext)",
          "controls": [ { "mc_text_box@hud.mc_text_box": {} } ]
        }
      },
      { "mc_text_gap": { "type": "panel", "$atext": "$actionbar_text", "size": [ "100%", 2 ], "ignored": "(($atext - '§k§c') = $atext)" } },
      {
        "mc_row_slot": {
          "type": "panel",
          "size": [ "100%", 14 ],
          "controls": [ { "mc_hud_row@hud.mc_hud_row": {} } ]
        }
      }
    ]
  },

  // The line's text, in its own bubble: the whole line, whose codes never render. A long line wraps.
  "mc_text_box": {
    "type": "image",
    "texture": "textures/ui/hud_tip_text_background",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ "100%c + 8px", "100%c + 4px" ],
    "layer": 30,
    "alpha": "@hud.anim_actionbar_text_background_alpha_out",
    "controls": [
      {
        "mc_text_label": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "max_size": [ 200, "default" ],
          "text_alignment": "right",
          "color": [ 1.0, 1.0, 1.0 ],
          "layer": 31,
          "text": "$actionbar_text",
          "shadow": true,
          "localize": false,
          "alpha": "@hud.anim_actionbar_text_alpha_out"
        }
      }
    ]
  },

  // The rounds' bubble, the own score's and the clock's (when the line has them), side by side.
  "mc_hud_row": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "$atext": "$actionbar_text",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ "100%c", 14 ],
    "controls": [
      { "mc_rounds_box@minecade_rounds.box": {} },
      { "mc_rounds_gap@minecade_rounds.gap": {} },
      { "mc_count_box@hud.mc_count_box": {} },
      {
        "mc_count_gap": {
          "type": "panel",
          "$atext": "$actionbar_text",
          "size": [ 2, 14 ],
          "ignored": "(($atext - '§k§u') = $atext)"
        }
      },
      { "mc_hud_box@hud.mc_hud_box": {} }
    ]
  },

  // The own score: a skull, then the digits. Each place (hundreds, tens, units) has a label per
  // digit, and only the one whose codes are in the line is kept ("ignored" leaves the others out
  // of the row, so a 5 is as narrow as one digit). A line without a score has no units codes, and
  // no box.
  "mc_count_box": {
    "type": "image",
    "$atext": "$actionbar_text",
    "texture": "textures/ui/hud_tip_text_background",
    "size": [ "100%c + 8px", 14 ],
    "layer": 30,
    "alpha": "@hud.anim_actionbar_text_background_alpha_out",
    "ignored": "(($atext - '§k§u') = $atext)",
    "visible": "(not (($atext - '§k§u') = $atext))",
    "controls": [
      {
        "mc_count_row": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ "100%c", 10 ],
          "controls": [
            {
              "mc_skull_icon": {
                "type": "image",
                "texture": "textures/minecade/hud/skull",
                "size": [ 10, 10 ],
                "layer": 31,
                "alpha": "@hud.anim_actionbar_text_alpha_out"
              }
            },
            { "mc_skull_gap": { "type": "panel", "size": [ 3, 10 ] } },
            { "h1@hud.mc_digit": { "text": "1", "ignored": "(($atext - '§k§h§1') = $atext)", "visible": "(not (($atext - '§k§h§1') = $atext))" } },
            { "h2@hud.mc_digit": { "text": "2", "ignored": "(($atext - '§k§h§2') = $atext)", "visible": "(not (($atext - '§k§h§2') = $atext))" } },
            { "h3@hud.mc_digit": { "text": "3", "ignored": "(($atext - '§k§h§3') = $atext)", "visible": "(not (($atext - '§k§h§3') = $atext))" } },
            { "h4@hud.mc_digit": { "text": "4", "ignored": "(($atext - '§k§h§4') = $atext)", "visible": "(not (($atext - '§k§h§4') = $atext))" } },
            { "h5@hud.mc_digit": { "text": "5", "ignored": "(($atext - '§k§h§5') = $atext)", "visible": "(not (($atext - '§k§h§5') = $atext))" } },
            { "h6@hud.mc_digit": { "text": "6", "ignored": "(($atext - '§k§h§6') = $atext)", "visible": "(not (($atext - '§k§h§6') = $atext))" } },
            { "h7@hud.mc_digit": { "text": "7", "ignored": "(($atext - '§k§h§7') = $atext)", "visible": "(not (($atext - '§k§h§7') = $atext))" } },
            { "h8@hud.mc_digit": { "text": "8", "ignored": "(($atext - '§k§h§8') = $atext)", "visible": "(not (($atext - '§k§h§8') = $atext))" } },
            { "h9@hud.mc_digit": { "text": "9", "ignored": "(($atext - '§k§h§9') = $atext)", "visible": "(not (($atext - '§k§h§9') = $atext))" } },
            { "t0@hud.mc_digit": { "text": "0", "ignored": "(($atext - '§k§t§0') = $atext)", "visible": "(not (($atext - '§k§t§0') = $atext))" } },
            { "t1@hud.mc_digit": { "text": "1", "ignored": "(($atext - '§k§t§1') = $atext)", "visible": "(not (($atext - '§k§t§1') = $atext))" } },
            { "t2@hud.mc_digit": { "text": "2", "ignored": "(($atext - '§k§t§2') = $atext)", "visible": "(not (($atext - '§k§t§2') = $atext))" } },
            { "t3@hud.mc_digit": { "text": "3", "ignored": "(($atext - '§k§t§3') = $atext)", "visible": "(not (($atext - '§k§t§3') = $atext))" } },
            { "t4@hud.mc_digit": { "text": "4", "ignored": "(($atext - '§k§t§4') = $atext)", "visible": "(not (($atext - '§k§t§4') = $atext))" } },
            { "t5@hud.mc_digit": { "text": "5", "ignored": "(($atext - '§k§t§5') = $atext)", "visible": "(not (($atext - '§k§t§5') = $atext))" } },
            { "t6@hud.mc_digit": { "text": "6", "ignored": "(($atext - '§k§t§6') = $atext)", "visible": "(not (($atext - '§k§t§6') = $atext))" } },
            { "t7@hud.mc_digit": { "text": "7", "ignored": "(($atext - '§k§t§7') = $atext)", "visible": "(not (($atext - '§k§t§7') = $atext))" } },
            { "t8@hud.mc_digit": { "text": "8", "ignored": "(($atext - '§k§t§8') = $atext)", "visible": "(not (($atext - '§k§t§8') = $atext))" } },
            { "t9@hud.mc_digit": { "text": "9", "ignored": "(($atext - '§k§t§9') = $atext)", "visible": "(not (($atext - '§k§t§9') = $atext))" } },
            { "u0@hud.mc_digit": { "text": "0", "ignored": "(($atext - '§k§u§0') = $atext)", "visible": "(not (($atext - '§k§u§0') = $atext))" } },
            { "u1@hud.mc_digit": { "text": "1", "ignored": "(($atext - '§k§u§1') = $atext)", "visible": "(not (($atext - '§k§u§1') = $atext))" } },
            { "u2@hud.mc_digit": { "text": "2", "ignored": "(($atext - '§k§u§2') = $atext)", "visible": "(not (($atext - '§k§u§2') = $atext))" } },
            { "u3@hud.mc_digit": { "text": "3", "ignored": "(($atext - '§k§u§3') = $atext)", "visible": "(not (($atext - '§k§u§3') = $atext))" } },
            { "u4@hud.mc_digit": { "text": "4", "ignored": "(($atext - '§k§u§4') = $atext)", "visible": "(not (($atext - '§k§u§4') = $atext))" } },
            { "u5@hud.mc_digit": { "text": "5", "ignored": "(($atext - '§k§u§5') = $atext)", "visible": "(not (($atext - '§k§u§5') = $atext))" } },
            { "u6@hud.mc_digit": { "text": "6", "ignored": "(($atext - '§k§u§6') = $atext)", "visible": "(not (($atext - '§k§u§6') = $atext))" } },
            { "u7@hud.mc_digit": { "text": "7", "ignored": "(($atext - '§k§u§7') = $atext)", "visible": "(not (($atext - '§k§u§7') = $atext))" } },
            { "u8@hud.mc_digit": { "text": "8", "ignored": "(($atext - '§k§u§8') = $atext)", "visible": "(not (($atext - '§k§u§8') = $atext))" } },
            { "u9@hud.mc_digit": { "text": "9", "ignored": "(($atext - '§k§u§9') = $atext)", "visible": "(not (($atext - '§k§u§9') = $atext))" } }
          ]
        }
      }
    ]
  },

  "mc_digit": {
    "type": "label",
    "$atext": "$actionbar_text",
    "size": [ "default", 10 ],
    "color": [ 1.0, 1.0, 1.0 ],
    "layer": 31,
    "shadow": true,
    "localize": false,
    "alpha": "@hud.anim_actionbar_text_alpha_out"
  },

  // The clock: a clock icon, then the digits its codes name (minecade_clock.json), white, or red in
  // the last 30 seconds. A line without a clock (no seconds code) has no box.
  "mc_hud_box": {
    "type": "image",
    "$atext": "$actionbar_text",
    "texture": "textures/ui/hud_tip_text_background",
    "size": [ "100%c + 8px", 14 ],
    "layer": 30,
    "alpha": "@hud.anim_actionbar_text_background_alpha_out",
    "ignored": "(($atext - '§k§a') = $atext)",
    "controls": [
      {
        "mc_clock_row": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ "100%c", 10 ],
          "controls": [
            {
              "mc_clock_icon": {
                "type": "image",
                "texture": "textures/minecade/hud/clock",
                "size": [ 10, 10 ],
                "layer": 31,
                "alpha": "@hud.anim_actionbar_text_alpha_out"
              }
            },
            { "mc_clock_gap": { "type": "panel", "size": [ 3, 10 ] } },
            { "mc_clock_digits@minecade_clock.digits": {} }
          ]
        }
      }
    ]
  },

  // The item name above the hotbar shows only its first line: the name. Vanilla adds a locked
  // item's lock lines under it ("Can't Move Items can't be: ...", "This item is not lost on death").
  // texts/en_US.lang draws them as nothing, and this cuts off whatever lines are left, so the box
  // stays one line tall. Vanilla's item_name_text_root, with the label in a one-line panel that
  // clips; the background follows that panel.
  "item_name_text_root": {
    "type": "panel",
    "size": [ "100%cm", "100%cm" ],
    "$show_interact_padding|default": false,
    "$show_survival_padding|default": false,
    "$show_text_background|default": false,
    "$localize|default": true,
    "$text_color|default": "$tool_tip_text",
    "$text_binding|default": "#item_text",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "$wait_duration|default": 1,
    "$destroy_id|default": "item_name_text",
    "controls": [
      {
        "item_text_aligner": {
          "type": "stack_panel",
          "size": [ "100%cm", "100%c" ],
          "controls": [
            {
              "item_text_control": {
                "type": "panel",
                "size": [ "100%cm", "100%cm" ],
                "controls": [
                  {
                    "item_text_background": {
                      "ignored": "(not $show_text_background)",
                      "type": "image",
                      "size": [ "100%sm + 12px", "100%sm + 5px" ],
                      "texture": "textures/ui/hud_tip_text_background",
                      "alpha": "@hud.anim_item_name_background_alpha_in"
                    }
                  },
                  {
                    "item_text_first_line": {
                      "type": "panel",
                      "size": [ "100%c", 10 ],
                      "clips_children": true,
                      "controls": [
                        {
                          "item_text_label": {
                            "type": "label",
                            "anchor_from": "top_middle",
                            "anchor_to": "top_middle",
                            "max_size": [ 200, "default" ],
                            "text_alignment": "center",
                            "layer": 31,
                            "color": "$text_color",
                            "text": "#text",
                            "localize": "$localize",
                            "alpha": "@hud.anim_item_name_text_alpha_in",
                            "shadow": true,
                            "bindings": [ { "binding_name": "$text_binding", "binding_name_override": "#text" } ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "interact_padding@common.empty_panel": {
                "visible": "$show_interact_padding",
                "size": [ "100%sm", 18 ],
                "bindings": [ { "binding_name": "#interact_visible", "binding_name_override": "#visible", "binding_condition": "always" } ]
              }
            },
            {
              "survival_buffer@common.empty_panel": {
                "visible": "$show_survival_padding",
                "size": [ "100%sm", 17 ],
                "bindings": [ { "binding_name": "#show_survival_ui", "binding_name_override": "#visible" } ]
              }
            }
          ]
        }
      }
    ]
  },

  // Effect icons (the right side of the screen) are hidden on every server: a locked queue makes
  // players invisible with an effect, and the HUD draws every icon as one piece, so the invisibility
  // one can't be hidden alone. Games don't show effects otherwise (only a kit can give one).
  // The column top left (vanilla's chat_stack) becomes mc_chat_stack, with the notes above the
  // paper doll and the chat. The sidebar is put in again with its own visibility: hidden while it
  // holds notes (an instance's bindings take the place of its def's, so scoreboards.json can't).
  "root_panel": {
    "modifications": [
      { "array_name": "controls", "operation": "remove", "control_name": "mob_effects_renderer" },
      { "array_name": "controls", "operation": "remove", "control_name": "chat_stack" },
      { "array_name": "controls", "operation": "remove", "control_name": "sidebar" },
      {
        "array_name": "controls",
        "operation": "insert_after",
        "control_name": "progress_rend",
        "value": [ { "chat_stack@hud.mc_chat_stack": {} } ]
      },
      {
        "array_name": "controls",
        "operation": "insert_after",
        "control_name": "game_tip",
        "value": [
          {
            "sidebar@scoreboard.scoreboard_sidebar": {
              "visible": false,
              "bindings": [
                { "binding_name": "#scoreboard_sidebar_visible", "binding_type": "global" },
                { "binding_name": "#objective_sidebar_name", "binding_type": "global" },
                {
                  "binding_type": "view",
                  "source_property_name": "(#scoreboard_sidebar_visible and ((#objective_sidebar_name - '§r§m§n§r') = #objective_sidebar_name))",
                  "target_property_name": "#visible"
                }
              ]
            }
          }
        ]
      }
    ]
  },

  // The paper doll moves into mc_chat_stack (mc_paper_doll), so the notes can sit above it.
  "centered_gui_elements": {
    "modifications": [ { "array_name": "controls", "operation": "remove", "control_name": "hud_player_rend_desktop" } ]
  },
  "not_centered_gui_elements": {
    "modifications": [ { "array_name": "controls", "operation": "remove", "control_name": "hud_player_rend_pocket" } ]
  },

  // Vanilla's chat_stack from 26.60 (the paper doll's and the HUD's padding, the coordinates, the
  // days played, tips and the chat), reordered: the touch layout's padding for its hearts first,
  // then the notes, then the paper doll in its own padding (where vanilla's desktop layout has it
  // while there are no notes; the touch layout's is 7 pixels lower, under the hearts' padding).
  "mc_chat_stack": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "40%", "100%" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "bindings": [
      { "binding_name": "#editor_chat_offset", "binding_name_override": "#offset", "binding_condition": "always" }
    ],
    "controls": [
      {
        "non_centered_gui_padding": {
          "type": "panel",
          "size": [ "100%", 32 ],
          "visible": false,
          "bindings": [
            { "binding_name": "#hud_visible_not_centered", "binding_type": "global" },
            { "binding_name": "#editor_chat_layout_active", "binding_condition": "always" },
            { "binding_type": "view", "source_property_name": "(#hud_visible_not_centered and not #editor_chat_layout_active)", "target_property_name": "#visible" }
          ]
        }
      },
      { "mc_notes@hud.mc_notes": {} },
      {
        "mc_paper_doll": {
          "type": "panel",
          "size": [ "100%", 50 ],
          "visible": false,
          "bindings": [
            { "binding_name": "#paper_doll_visible" },
            { "binding_name": "#editor_chat_layout_active", "binding_condition": "always" },
            { "binding_type": "view", "source_property_name": "(#paper_doll_visible and not #editor_chat_layout_active)", "target_property_name": "#visible" }
          ],
          "controls": [
            {
              "centered@hud.hud_player_renderer": {
                "offset": "$hud_player_rend_desktop_offset",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "visible": false,
                "bindings": [ { "binding_name": "#hud_visible_centered_gui_elements", "binding_name_override": "#visible", "binding_type": "global" } ]
              }
            },
            {
              "not_centered@hud.hud_player_renderer": {
                "offset": [ 15, 0 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "visible": false,
                "bindings": [ { "binding_name": "#hud_visible_not_centered", "binding_name_override": "#visible", "binding_type": "global" } ]
              }
            }
          ]
        }
      },
      { "player_position@hud.player_position": {} },
      { "number_of_days_played@hud.number_of_days_played": {} },
      { "game_tip@game_tip.game_tip_chat_stack_factory": { "size": [ "100%", "100%c" ] } },
      {
        "chat_panel@hud.chat_panel": {
          "bindings": [ { "binding_name": "#editor_chat_visible", "binding_name_override": "#visible", "binding_condition": "always" } ]
        }
      }
    ]
  },

  // Notes top left (Notes in packages/minigame-core/src/game/sidebar.ts): a sidebar whose title is
  // the notes mark ('§r§m§n§r', NOTES_MARK in hud.ts) shows here instead of as the vanilla sidebar
  // (root_panel's sidebar hides then), each of its lines in a bubble of its own, top to bottom,
  // wrapping when it's long. The lines are the sidebar's participants, in its order; scores aren't
  // shown.
  "mc_notes": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "visible": false,
    "collection_name": "scoreboard_players",
    "factory": { "name": "player_list_factory", "control_name": "hud.mc_note" },
    "bindings": [
      { "binding_name": "#scoreboard_sidebar_size", "binding_type": "global", "binding_name_override": "#collection_length" },
      { "binding_name": "#objective_sidebar_name", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#objective_sidebar_name - '§r§m§n§r') = #objective_sidebar_name))",
        "target_property_name": "#visible"
      }
    ]
  },

  // One note: its bubble against the left edge, 2 pixels under the one above.
  "mc_note": {
    "type": "panel",
    "size": [ "100%", "100%c + 2px" ],
    "controls": [
      {
        "mc_note_box": {
          "type": "image",
          "texture": "textures/ui/hud_tip_text_background",
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [ 4, 0 ],
          "size": [ "100%c + 8px", "100%c + 4px" ],
          "layer": 30,
          "alpha": 0.6,
          "controls": [
            {
              "mc_note_label": {
                "type": "label",
                "anchor_from": "center",
                "anchor_to": "center",
                "max_size": [ 200, "default" ],
                "color": [ 1.0, 1.0, 1.0 ],
                "layer": 31,
                "text": "#player_name_sidebar",
                "shadow": true,
                "localize": false,
                "bindings": [
                  { "binding_name": "#player_name_sidebar", "binding_type": "collection", "binding_collection_name": "scoreboard_players" }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}

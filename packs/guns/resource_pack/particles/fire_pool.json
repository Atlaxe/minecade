{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "minecade:fire_pool",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/minecade/guns/puff"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "v.radius * v.radius * 10",
        "max_particles": 300
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.seconds"
      },
      "minecraft:emitter_shape_disc": {
        "radius": "v.radius",
        "plane_normal": [
          0,
          1,
          0
        ],
        "offset": [
          0,
          0.1,
          0
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_initial_speed": "0.3 + v.particle_random_1 * 0.6",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 + v.particle_random_2 * 0.5"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.2,
          0
        ],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.28 * (1 - v.particle_age / v.particle_lifetime) + 0.06",
          "0.28 * (1 - v.particle_age / v.particle_lifetime) + 0.06"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "math.lerp(0.85, 0.25, v.particle_age / v.particle_lifetime)",
          "math.lerp(0.35, 0.05, v.particle_age / v.particle_lifetime)",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}

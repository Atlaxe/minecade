{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "minecade:explosion",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/minecade/guns/puff"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "16 + v.radius * 6"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.radius * 0.2",
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "v.radius * (1.2 + v.particle_random_1 * 1.6)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 + v.particle_random_2 * 0.8"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.8,
          0
        ],
        "linear_drag_coefficient": 3.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.35 + v.particle_random_3 * 0.45) * (1 + v.particle_age * 1.5)",
          "(0.35 + v.particle_random_3 * 0.45) * (1 + v.particle_age * 1.5)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1, 0.3, math.min(1, v.particle_age / v.particle_lifetime * 2.5))",
          "math.lerp(0.75, 0.29, math.min(1, v.particle_age / v.particle_lifetime * 2.5))",
          "math.lerp(0.3, 0.28, math.min(1, v.particle_age / v.particle_lifetime * 2.5))",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}

{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecade:gray_paintball_shotgun",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/minecade/guns/shotgun/gray",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.minecade.gun_shotgun"
      },
      "animations": {
        "first_person": "animation.minecade.gun_shotgun.hold_first_person",
        "third_person": "animation.minecade.gun_shotgun.hold_third_person",
        "recoil": "animation.minecade.gun_shotgun.recoil"
      },
      "scripts": {
        "initialize": [
          "v.aim = 0;",
          "v.kick = 0;"
        ],
        "pre_animation": [
          "v.aim = math.lerp(v.aim, q.is_using_item, math.min(q.delta_time * 14, 1));",
          "v.kick_left = math.clamp(q.cooldown_time_remaining('minecade_shotgun_shot') / 0.3, 0, 1);",
          "v.kick = v.kick_left > 0.75 ? (1 - v.kick_left) * 4 : v.kick_left / 0.75;"
        ],
        "animate": [
          {
            "first_person": "c.is_first_person"
          },
          {
            "third_person": "!c.is_first_person"
          },
          "recoil"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}

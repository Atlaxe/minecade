{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "blockparty:die_burst_cursed",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/blockparty/dice/cursed"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 30
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.25,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + v.particle_random_4 * 0.5"
      },
      "minecraft:particle_initial_speed": "math.random(4, 9)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-900, 900)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -16,
          0
        ],
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.06 + v.particle_random_4 * 0.06) * (1 - math.pow(v.particle_age / v.particle_lifetime, 3))",
          "(0.06 + v.particle_random_4 * 0.06) * (1 - math.pow(v.particle_age / v.particle_lifetime, 3))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            "math.floor(v.particle_random_1 * 4) / 4",
            "math.floor(v.particle_random_2 * 4) / 4"
          ],
          "uv_size": [
            0.25,
            0.25
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}

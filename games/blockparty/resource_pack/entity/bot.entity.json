{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "blockparty:bot",
      "materials": {
        "default": "entity_alphatest",
        "fade": "guardian_ghost"
      },
      "textures": {
        "steve": "textures/entity/steve",
        "alex": "textures/entity/alex",
        "ari": "textures/blockparty/skins/ari",
        "efe": "textures/blockparty/skins/efe",
        "kai": "textures/blockparty/skins/kai",
        "makena": "textures/blockparty/skins/makena",
        "noor": "textures/blockparty/skins/noor",
        "sunny": "textures/blockparty/skins/sunny",
        "zuri": "textures/blockparty/skins/zuri",
        "tennis_steve": "textures/blockparty/skins/tennis_steve",
        "tuxedo_steve": "textures/blockparty/skins/tuxedo_steve",
        "athlete_steve": "textures/blockparty/skins/athlete_steve",
        "scottish_steve": "textures/blockparty/skins/scottish_steve",
        "prisoner_steve": "textures/blockparty/skins/prisoner_steve",
        "cyclist_steve": "textures/blockparty/skins/cyclist_steve",
        "boxer_steve": "textures/blockparty/skins/boxer_steve",
        "tennis_alex": "textures/blockparty/skins/tennis_alex",
        "tuxedo_alex": "textures/blockparty/skins/tuxedo_alex",
        "athlete_alex": "textures/blockparty/skins/athlete_alex",
        "swedish_alex": "textures/blockparty/skins/swedish_alex",
        "prisoner_alex": "textures/blockparty/skins/prisoner_alex",
        "cyclist_alex": "textures/blockparty/skins/cyclist_alex",
        "boxer_alex": "textures/blockparty/skins/boxer_alex",
        "developer_alex": "textures/blockparty/skins/developer_alex",
        "developer_steve": "textures/blockparty/skins/developer_steve"
      },
      "geometry": {
        "default": "geometry.humanoid.custom",
        "slim": "geometry.humanoid.customSlim"
      },
      "render_controllers": [
        "controller.render.blockparty.bot"
      ],
      "animations": {
        "humanoid_base_pose": "animation.humanoid.base_pose",
        "look_at_target": "animation.humanoid.look_at_target.default",
        "move": "animation.humanoid.move",
        "bob": "animation.humanoid.bob",
        "holding": "animation.player.holding",
        "bow": "animation.player.bow_equipped",
        "attack.rotations": "animation.player.attack.rotations",
        "sneaking": "animation.player.sneaking"
      },
      "scripts": {
        "scale": "0.9375",
        "initialize": [
          "v.gliding_speed_value = 1.0;",
          "v.fade = q.property('blockparty:faded') ? 0.0 : 1.0;",
          "v.skin = q.property('blockparty:skin');",
          "v.is_holding_right = 0.0;",
          "v.attack_time = 0.0;",
          "v.swing_start = -1.0;",
          "v.swing_seen = q.property('blockparty:swing');"
        ],
        "pre_animation": [
          "v.tcos0 = (math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed / v.gliding_speed_value) * 57.3;",
          "v.fade = math.clamp(v.fade + (q.property('blockparty:faded') ? -1.0 : 1.0) * q.delta_time * 2.5, 0.0, 1.0);",
          "v.skin = q.property('blockparty:skin');",
          "v.is_holding_right = q.is_item_equipped(0);",
          "v.swing_start = q.property('blockparty:swing') != v.swing_seen ? q.life_time : v.swing_start;",
          "v.swing_seen = q.property('blockparty:swing');",
          "v.attack_time = q.life_time - v.swing_start < 0.3 ? (q.life_time - v.swing_start) / 0.3 : 0.0;",
          "v.attack_body_rot_y = math.sin(360 * math.sqrt(v.attack_time)) * 5.0;"
        ],
        "animate": [
          "humanoid_base_pose",
          "look_at_target",
          "move",
          "holding",
          {
            "bow": "q.property('blockparty:pose') == 2"
          },
          {
            "attack.rotations": "v.attack_time > 0.0"
          },
          {
            "sneaking": "q.property('blockparty:pose') == 1"
          },
          "bob"
        ]
      },
      "enable_attachables": true
    }
  }
}

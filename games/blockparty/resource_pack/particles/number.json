{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "blockparty:number",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/blockparty/numbers"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.1
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.vx * v.particle_age",
          "v.vy * v.particle_age",
          "v.vz * v.particle_age"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.half_w",
          "v.half_h"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 304,
          "uv": [
            "math.mod(v.cell, 16) * 32",
            "math.floor(v.cell / 16) * 16"
          ],
          "uv_size": [
            32,
            16
          ]
        }
      }
    }
  }
}

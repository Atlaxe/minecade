{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "minecade:smoke_cloud",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/minecade/guns/puff"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "v.radius * 7",
        "max_particles": 220
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "math.max(1, v.seconds - 3)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.radius * 0.75",
        "offset": [
          0,
          "v.radius * 0.45",
          0
        ],
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "0.2 + v.particle_random_1 * 0.4",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "3 + v.particle_random_2"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.2 + v.particle_random_3 + v.particle_age * 0.15",
          "1.2 + v.particle_random_3 + v.particle_age * 0.15"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.74,
          0.74,
          0.76,
          "0.92 * math.min(1, v.particle_age * 2) * math.min(1, (v.particle_lifetime - v.particle_age) * 1.2)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
